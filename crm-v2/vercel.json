{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "redirects": [
    {
      "source": "/haldus:rest(.*)",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/tasemetest:rest(.*)",
      "destination": "https://www.epkoolitus.ee/tasemetest:rest",
      "permanent": false
    },
    {
      "source": "/kutse:rest(.*)",
      "destination": "https://www.epkoolitus.ee/kutse:rest",
      "permanent": false
    },
    {
      "source": "/privaatsus:rest(.*)",
      "destination": "https://www.epkoolitus.ee/privaatsus:rest",
      "permanent": false
    },
    {
      "source": "/tingimused:rest(.*)",
      "destination": "https://www.epkoolitus.ee/tingimused:rest",
      "permanent": false
    },
    {
      "source": "/interactive-lesson/:rest(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/live-classroom.html",
      "destination": "/live-classroom",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://us-central1-keelesepp-5136b.cloudfunctions.net/sheetBuilderApi/oauth/protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "https://us-central1-keelesepp-5136b.cloudfunctions.net/sheetBuilderApi/oauth/protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://us-central1-keelesepp-5136b.cloudfunctions.net/sheetBuilderApi/oauth/authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "https://us-central1-keelesepp-5136b.cloudfunctions.net/sheetBuilderApi/oauth/authorization-server"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "https://us-central1-keelesepp-5136b.cloudfunctions.net/sheetBuilderApi/oauth/authorization-server"
    },
    {
      "source": "/ai/mcp",
      "destination": "https://us-central1-keelesepp-5136b.cloudfunctions.net/sheetBuilderApi/mcp"
    },
    {
      "source": "/ai/oauth/:path*",
      "destination": "https://us-central1-keelesepp-5136b.cloudfunctions.net/sheetBuilderApi/oauth/:path*"
    },
    {
      "source": "/ajad",
      "destination": "/ajad.html"
    },
    {
      "source": "/((?!assets/|audio/|textbook-art/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(audio|textbook-art)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://api.openverse.org https://upload.wikimedia.org https://thumb.wikimedia.org; media-src 'self' data: blob: https://firebasestorage.googleapis.com; connect-src 'self' data: blob: https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebasestorage.googleapis.com https://us-central1-keelesepp-5136b.cloudfunctions.net https://api.openverse.org https://api.mymemory.translated.net https://commons.wikimedia.org https://upload.wikimedia.org https://thumb.wikimedia.org; frame-src 'self' blob: https://keelesepp-5136b.firebaseapp.com https://firebasestorage.googleapis.com https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
