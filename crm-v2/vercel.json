{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in agent/*) echo \"skip preview for agent branch\"; exit 0;; *) exit 1;; esac",
  "redirects": [
    {
      "source": "/haldus:rest(.*)",
      "destination": "https://www.epkoolitus.ee/haldus:rest",
      "permanent": false
    },
    {
      "source": "/tasemetest:rest(.*)",
      "destination": "https://www.epkoolitus.ee/tasemetest:rest",
      "permanent": false
    },
    {
      "source": "/kutse:rest(.*)",
      "destination": "https://www.epkoolitus.ee/kutse:rest",
      "permanent": false
    },
    {
      "source": "/privaatsus:rest(.*)",
      "destination": "https://www.epkoolitus.ee/privaatsus:rest",
      "permanent": false
    },
    {
      "source": "/tingimused:rest(.*)",
      "destination": "https://www.epkoolitus.ee/tingimused:rest",
      "permanent": false
    },
    {
      "source": "/interactive-lesson/:rest(.*)",
      "destination": "https://www.epkoolitus.ee/interactive-lesson/:rest",
      "permanent": false
    },
    {
      "source": "/live-classroom.html",
      "destination": "https://www.epkoolitus.ee/live-classroom.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
        }
      ]
    }
  ]
}
