{
  "name": "keelesepp-functions",
  "description": "KeeleSepp Firebase Cloud Functions",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "test": "node --test",
    "test:emulator": "node --test finance-emulator.integration.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "main.js",
  "dependencies": {
    "axios": "^1.6.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "googleapis": "^173.0.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0",
    "proxyquire": "^2.1.3",
    "rewire": "^9.0.1"
  },
  "private": true
}
