rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Same account gate as Firestore: disabled, pending and rejected accounts get nothing.
    function signedIn() {
      return request.auth != null
        && (
          !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          || (
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true
            && !(firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('approvalStatus', 'approved') in ['pending', 'rejected'])
          )
        );
    }

    function email() {
      return request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function superAdmin() {
      return signedIn() && email() in ['zakutailo.pavel@gmail.com'];
    }

    function role() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function staff() {
      return superAdmin() || role() in ['teacher', 'admin'];
    }

    function accountingAdmin() {
      return superAdmin() || role() == 'admin';
    }

    function ownsStudent(studentId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/students/$(studentId))
        && (
          firestore.get(/databases/(default)/documents/students/$(studentId)).data.linkedUserId == request.auth.uid
          || firestore.get(/databases/(default)/documents/students/$(studentId)).data.studentUid == request.auth.uid
          || firestore.get(/databases/(default)/documents/students/$(studentId)).data.get('linkedUserIds', []).hasAny([request.auth.uid])
          || firestore.get(/databases/(default)/documents/students/$(studentId)).data.linkedParentId == request.auth.uid
          || firestore.get(/databases/(default)/documents/students/$(studentId)).data.parentUid == request.auth.uid
          || firestore.get(/databases/(default)/documents/students/$(studentId)).data.guardianUid == request.auth.uid
          || firestore.get(/databases/(default)/documents/students/$(studentId)).data.get('linkedParentIds', []).hasAny([request.auth.uid])
        );
    }

    function safeContent() {
      return request.resource == null
        || (
          request.resource.size < 20 * 1024 * 1024
          && request.resource.contentType is string
          && request.resource.contentType.matches('^(image/.*|application/pdf|text/plain|text/csv|audio/.*|video/.*|application/vnd\\..*|application/msword)$')
        );
    }

    function safeDidacticContent() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.matches('^(application/pdf|application/epub\\+zip|text/.*|image/.*|application/msword|application/rtf|application/vnd\\.openxmlformats-officedocument\\..*|application/vnd\\.ms-powerpoint)$');
    }

    function safePaymentOrder() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png|image/webp)$');
    }

    match /eesti_soned.json {
      allow read: if signedIn();
      allow write: if staff();
    }

    match /worksheet/{fileName} {
      allow read: if signedIn();
      allow write: if staff() && safeContent();
    }

    match /worksheet-submissions/{studentId}/{assignmentId}/{fileName} {
      allow read: if staff() || ownsStudent(studentId);
      allow create: if (staff() || ownsStudent(studentId))
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.matches('^audio/.*$');
      allow update, delete: if false;
    }

    match /curriculum/{fileName} {
      allow read: if signedIn();
      allow write: if staff() && safeContent();
    }

    match /student-worksheets/{studentId}/{fileName} {
      allow read: if staff() || ownsStudent(studentId);
      allow write: if staff() && safeContent();
    }

    match /didactics/{staffUid}/{fileName} {
      allow read: if staff();
      allow write: if staff() && staffUid == request.auth.uid && safeDidacticContent();
    }

    match /lessons/{studentId}/{fileName} {
      allow read: if staff() || ownsStudent(studentId);
      allow write: if staff() && safeContent();
    }

    // Live Classroom lesson recordings: only the recording teacher uploads audio while the recording runs.
    function recordingDoc(recordingId) {
      return firestore.get(/databases/(default)/documents/lessonRecordings/$(recordingId)).data;
    }

    match /lessonRecordings/{recordingId}/{fileName} {
      allow read: if superAdmin() || role() == 'admin'
        || (staff() && firestore.exists(/databases/(default)/documents/lessonRecordings/$(recordingId)) && recordingDoc(recordingId).teacherUid == request.auth.uid);
      allow write: if staff()
        && firestore.exists(/databases/(default)/documents/lessonRecordings/$(recordingId))
        && recordingDoc(recordingId).teacherUid == request.auth.uid
        && recordingDoc(recordingId).status == 'recording'
        && request.resource != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('^audio/.*$');
    }

    match /homework/{studentId}/{fileName} {
      allow read: if staff() || ownsStudent(studentId);
      allow write: if (staff() || ownsStudent(studentId)) && safeContent();
    }

    // Reusable illustrations for adaptive lessons. These are non-sensitive
    // teaching assets, so learners may load them without Firebase Auth. Only
    // staff can create, replace or delete scene files.
    match /lesson-scenes/{allPaths=**} {
      allow read: if true;
      allow write: if staff() && safeContent();
    }

    // Images/PDFs uploaded directly onto a student's whiteboard. Uploading
    // material is a teacher/admin action; linked students and parents may
    // read the resulting object but cannot replace or delete it in Storage.
    match /whiteboards/{studentId}/materials/{fileName} {
      allow read: if staff() || ownsStudent(studentId);
      allow write: if staff() && safeContent();
    }

    // A student's (or parent's) own photos on the board, e.g. a notebook page: images only, up to 10 MB.
    match /whiteboards/{studentId}/student/{fileName} {
      allow read: if staff() || ownsStudent(studentId);
      allow write: if (staff() || ownsStudent(studentId))
        && (request.resource == null
          || (request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('^image/.*$')));
    }

    match /financial/payment-orders/{paymentId}/{documentId} {
      allow read: if accountingAdmin();
      allow create: if accountingAdmin() && safePaymentOrder();
      allow update, delete: if false;
    }

    match /financial/expenses/{expenseId}/{documentId} {
      allow read: if accountingAdmin();
      allow create: if accountingAdmin() && safePaymentOrder();
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
