rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Disabled accounts and self-registered accounts still waiting for an administrator ("pending") or
    // turned down ("rejected") are treated as signed out everywhere. Accounts without approvalStatus are approved.
    function signedIn() {
      return request.auth != null
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true
            && !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approvalStatus', 'approved') in ['pending', 'rejected'])
          )
        );
    }

    function uid() {
      return request.auth.uid;
    }

    function email() {
      return request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function superAdmin() {
      return signedIn() && email() in ['zakutailo.pavel@gmail.com'];
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function hasUserDoc(userId) {
      return exists(userPath(userId));
    }

    function userRole(userId) {
      return hasUserDoc(userId) ? get(userPath(userId)).data.role : '';
    }

    function isAdmin() {
      return superAdmin() || (signedIn() && userRole(uid()) == 'admin');
    }

    function isFinance() {
      return signedIn() && userRole(uid()) == 'finance';
    }

    function isStaff() {
      return isAdmin() || (signedIn() && userRole(uid()) == 'teacher');
    }

    function isTeacher() {
      return signedIn() && userRole(uid()) == 'teacher';
    }

    function financialDateOpen(value) {
      return !(value is string)
        || !value.matches('^\\d{4}-\\d{2}-\\d{2}$')
        || !exists(/databases/$(database)/documents/financialLockedDates/$(value));
    }

    function teacherName(userId) {
      return hasUserDoc(userId)
        ? get(userPath(userId)).data.get('displayName', '')
        : '';
    }

    function sameTeacherName(left, right) {
      return left is string
        && right is string
        && (
          left.lower() == right.lower()
          || (
            left.lower().matches('^pavel( .*)?$')
            && right.lower().matches('^pavel( .*)?$')
          )
          || (
            left.lower().matches('^(jelena|elena)( .*)?$')
            && right.lower().matches('^(jelena|elena)( .*)?$')
          )
          || (
            left.lower().matches('^(elizaveta|yelyzaveta)( .*)?$')
            && right.lower().matches('^(elizaveta|yelyzaveta)( .*)?$')
          )
          || (
            left.lower().matches('^(angelina|anhelina)( .*)?$')
            && right.lower().matches('^(angelina|anhelina)( .*)?$')
          )
        );
    }

    function teacherOwnsStudentData(data) {
      return isTeacher()
        && sameTeacherName(data.get('teacher', ''), teacherName(uid()));
    }

    function teacherScopeReadEnforced() {
      return signedIn()
        && exists(/databases/$(database)/documents/securityMigrations/teacherUidV1)
        && get(/databases/$(database)/documents/securityMigrations/teacherUidV1).data.get('readEnforced', false) == true;
    }

    function teacherCanRead(data) {
      return isTeacher()
        && (
          !teacherScopeReadEnforced()
          || data.get('teacherUid', '') == uid()
          || data.get('teacherUids', []).hasAny([uid()])
        );
    }

    function teacherCanCreate(data) {
      return isTeacher()
        && (
          data.get('teacherUid', '') == uid()
          || (
            !teacherScopeReadEnforced()
            && data.get('teacherUid', '') == ''
            && teacherOwnsStudentData(data)
          )
        );
    }

    function teacherCanUpdate(before, after) {
      return isTeacher()
        && (
          (
            before.get('teacherUid', '') == uid()
            && after.get('teacherUid', '') == uid()
          )
          || (
            !teacherScopeReadEnforced()
            && before.get('teacherUid', '') == ''
            && after.get('teacherUid', '') == ''
            && teacherOwnsStudentData(before)
            && teacherOwnsStudentData(after)
          )
        );
    }

    function studentPath(studentId) {
      return /databases/$(database)/documents/students/$(studentId);
    }

    function studentDoc(studentId) {
      return get(studentPath(studentId)).data;
    }

    function ownsStudentProfile(studentId, student) {
      return signedIn()
        && (
          studentId == uid()
          || student.get('linkedUserId', '') == uid()
          || student.get('studentUid', '') == uid()
          || student.get('linkedUserIds', []).hasAny([uid()])
          || student.get('linkedParentId', '') == uid()
          || student.get('parentUid', '') == uid()
          || student.get('guardianUid', '') == uid()
          || student.get('linkedParentIds', []).hasAny([uid()])
        );
    }

    function ownsStudent(studentId) {
      return signedIn()
        && exists(studentPath(studentId))
        && ownsStudentProfile(studentId, studentDoc(studentId));
    }

    function studentAccountOwns(studentId, userId) {
      return exists(studentPath(studentId))
        && (
          studentId == userId
          || studentDoc(studentId).get('linkedUserId', '') == userId
          || studentDoc(studentId).get('studentUid', '') == userId
          || studentDoc(studentId).get('linkedUserIds', []).hasAny([userId])
        );
    }

    function teacherCanInviteStudent(studentId) {
      return isAdmin()
        || (
          isTeacher()
          && exists(studentPath(studentId))
          && (
            studentDoc(studentId).get('teacherUid', '') == uid()
            || studentDoc(studentId).get('teacherUids', []).hasAny([uid()])
            || (
              !teacherScopeReadEnforced()
              && teacherOwnsStudentData(studentDoc(studentId))
            )
          )
        );
    }

    // Homework, submissions and messages of a student: the administrator, or a teacher of that student's card
    // (teacherUid / teacherUids; by name while teacher scope is not enforced). Owner decision 2026-10-11:
    // a teacher sees only their own students' correspondence and homework.
    // Cheap uid checks first, the name comparison last: these rules also run inside large Live Classroom batches.
    function staffCanAccessStudent(studentId) {
      return isAdmin()
        || (
          isTeacher()
          && studentId is string
          && studentId != ''
          && exists(studentPath(studentId))
          && (
            studentDoc(studentId).get('teacherUid', '') == uid()
            || studentDoc(studentId).get('teacherUids', []).hasAny([uid()])
            || (!teacherScopeReadEnforced() && teacherOwnsStudentData(studentDoc(studentId)))
          )
        );
    }

    function liveLessonInvitationPath(invitationId) {
      return /databases/$(database)/documents/liveLessonInvitations/$(invitationId);
    }

    // Group lessons (owner, 2026-10-04): one room for a teacher and up to 4 students; each student is invited with a
    // normal invitation whose roomKey is the group room id.
    function liveGroupRoomPath(roomId) {
      return /databases/$(database)/documents/liveGroupRooms/$(roomId);
    }

    function liveGroupParticipant(roomId) {
      return signedIn()
        && exists(liveGroupRoomPath(roomId))
        && (
          isAdmin()
          || get(liveGroupRoomPath(roomId)).data.teacherUid == uid()
          || get(liveGroupRoomPath(roomId)).data.memberUids.hasAny([uid()])
        );
    }

    function liveGroupOpenParticipant(roomId) {
      return liveGroupParticipant(roomId) && get(liveGroupRoomPath(roomId)).data.status == 'open';
    }

    function liveGroupInvites(roomId, studentUid) {
      return exists(liveGroupRoomPath(roomId))
        && get(liveGroupRoomPath(roomId)).data.teacherUid == uid()
        && get(liveGroupRoomPath(roomId)).data.status == 'open'
        && get(liveGroupRoomPath(roomId)).data.memberUids.hasAny([studentUid]);
    }

    function validLiveGroupMembers(data) {
      return data.memberUids is list
        && data.memberUids.size() >= 1
        && data.memberUids.size() <= 4
        && data.members is list
        && data.members.size() == data.memberUids.size();
    }

    function canUseLiveLessonInvitation(invitationId) {
      return signedIn()
        && exists(liveLessonInvitationPath(invitationId))
        && get(liveLessonInvitationPath(invitationId)).data.status == 'accepted'
        && (
          get(liveLessonInvitationPath(invitationId)).data.teacherUid == uid()
          || get(liveLessonInvitationPath(invitationId)).data.studentUid == uid()
        );
    }

    function canReadLiveLessonRoom(invitationId) {
      return signedIn()
        && exists(liveLessonInvitationPath(invitationId))
        && get(liveLessonInvitationPath(invitationId)).data.status in ['accepted', 'closed']
        && (
          get(liveLessonInvitationPath(invitationId)).data.teacherUid == uid()
          || get(liveLessonInvitationPath(invitationId)).data.studentUid == uid()
        );
    }

    // Live Classroom guest link (functions/live-guest.js): the server writes liveGuestGrants/{uid} for a guest who
    // opened the teacher's link; the grant opens only that card's board and the worksheets of that lesson room.
    function liveGuestGrantPath() {
      return /databases/$(database)/documents/liveGuestGrants/$(uid());
    }

    function liveGuestFor(studentId) {
      return signedIn()
        && request.auth.token.get('liveGuest', false) == true
        && exists(liveGuestGrantPath())
        && get(liveGuestGrantPath()).data.studentId == studentId
        && get(liveGuestGrantPath()).data.expiresAt > request.time;
    }

    function liveGuestRoomSheet(data) {
      return liveGuestFor(data.studentId)
        && data.get('liveRoomKey', '') == get(liveGuestGrantPath()).data.invitationId;
    }

    function validLiveLessonWhiteboardStroke(data) {
      return data is map
        && data.keys().hasOnly([
          'type',
          'points',
          'color',
          'strokeWidth',
          'updatedAt',
          'updatedByUid',
          'updatedByName',
          'lastClientId',
          'revision'
        ])
        && data.keys().hasAll([
          'type',
          'points',
          'color',
          'strokeWidth',
          'updatedAt',
          'updatedByUid',
          'updatedByName',
          'lastClientId',
          'revision'
        ])
        && data.type == 'stroke'
        && data.points is list
        && data.points.size() >= 2
        && data.points.size() <= 800
        && data.color is string
        && data.color.size() > 0
        && data.color.size() <= 32
        && data.strokeWidth is number
        && data.strokeWidth > 0
        && data.strokeWidth <= 40
        && data.updatedAt == request.time
        && data.updatedByUid == uid()
        && data.updatedByName is string
        && data.updatedByName.size() <= 160
        && data.lastClientId is string
        && data.lastClientId.size() > 0
        && data.lastClientId.size() <= 120
        && data.revision == 1;
    }

    function liveLessonSignalRoleMatches(invitationId, role) {
      return (
          role == 'teacher'
          && get(liveLessonInvitationPath(invitationId)).data.teacherUid == uid()
        )
        || (
          role == 'student'
          && get(liveLessonInvitationPath(invitationId)).data.studentUid == uid()
        );
    }

    function validInitialAssessment(data, studentId) {
      return data is map
        && data.keys().hasOnly([
          'studentId',
          'assessmentDate',
          'currentLevel',
          'targetLevel',
          'overallStatus',
          'grammarData',
          'vocabularyData',
          'skillsData',
          'strengths',
          'developmentAreas',
          'learningFocus',
          'createdAt',
          'updatedAt',
          'createdByUid',
          'createdByName',
          'updatedByUid',
          'updatedByName',
          'version'
        ])
        && data.keys().hasAll([
          'studentId',
          'assessmentDate',
          'currentLevel',
          'targetLevel',
          'overallStatus',
          'grammarData',
          'vocabularyData',
          'skillsData',
          'strengths',
          'developmentAreas',
          'learningFocus',
          'createdAt',
          'updatedAt',
          'createdByUid',
          'createdByName',
          'updatedByUid',
          'updatedByName',
          'version'
        ])
        && data.studentId == studentId
        && data.assessmentDate is string
        && data.assessmentDate.size() <= 10
        && data.currentLevel is string
        && data.currentLevel.size() <= 40
        && data.targetLevel is string
        && data.targetLevel.size() <= 40
        && data.overallStatus in ['needs_work', 'developing', 'near_target', 'target_reached']
        && data.grammarData is list
        && data.grammarData.size() <= 60
        && data.vocabularyData is list
        && data.vocabularyData.size() <= 60
        && data.skillsData is list
        && data.skillsData.size() <= 20
        && data.strengths is list
        && data.strengths.size() <= 30
        && data.developmentAreas is list
        && data.developmentAreas.size() <= 30
        && data.learningFocus is string
        && data.learningFocus.size() <= 6000
        && data.createdAt is string
        && data.updatedAt is string
        && data.createdByUid is string
        && data.createdByName is string
        && data.updatedByUid is string
        && data.updatedByName is string
        && data.version == 1;
    }

    function liveClassroomPath(classroomId) {
      return /databases/$(database)/documents/liveClassrooms/$(classroomId);
    }

    function liveClassroomData(classroomId) {
      return get(liveClassroomPath(classroomId)).data;
    }

    function ownsLiveClassroom(classroomId) {
      return signedIn()
        && exists(liveClassroomPath(classroomId))
        && ownsStudent(liveClassroomData(classroomId).studentId);
    }

    function hostsLiveClassroom(classroomId) {
      return isAdmin()
        || (
          signedIn()
          && exists(liveClassroomPath(classroomId))
          && liveClassroomData(classroomId).teacherUid == uid()
        );
    }

    function validLiveSceneSource(source) {
      return source is map
        && source.keys().hasOnly(['kind', 'id', 'type'])
        && source.keys().hasAll(['kind', 'id', 'type'])
        && source.kind is string
        && source.kind.size() > 0
        && source.kind.size() <= 40
        && source.id is string
        && source.id.size() > 0
        && source.id.size() <= 180
        && source.type is string
        && source.type.size() <= 40;
    }

    function validLiveScene(scene, expectedVersion) {
      return scene is map
        && scene.keys().hasOnly([
          'type',
          'title',
          'body',
          'options',
          'version',
          'publishedAt',
          'source',
          'actionUrl'
        ])
        && scene.keys().hasAll(['type', 'version'])
        && scene.type in ['welcome', 'message', 'choice', 'short_answer', 'screen']
        && scene.version == expectedVersion
        && (
          !('title' in scene)
          || (
            scene.title is string
            && scene.title.size() <= 160
          )
        )
        && (
          !('body' in scene)
          || (
            scene.body is string
            && scene.body.size() <= 4000
          )
        )
        && (
          !('options' in scene)
          || (
            scene.options is list
            && scene.options.size() <= 8
          )
        )
        && (
          scene.type != 'choice'
          || (
            'options' in scene
            && scene.options is list
            && scene.options.size() >= 2
          )
        )
        && (
          !('publishedAt' in scene)
          || (
            scene.publishedAt is string
            && scene.publishedAt.size() <= 40
          )
        )
        && (
          !('source' in scene)
          || validLiveSceneSource(scene.source)
        )
        && (
          !('actionUrl' in scene)
          || (
            scene.actionUrl is string
            && scene.actionUrl.size() <= 500
            && (
              scene.actionUrl.matches('^/haldus-exercises/.*')
              || scene.actionUrl.matches('^/haldus-worksheet/.*')
            )
          )
        );
    }

    function validLiveScreenShare(screenShare) {
      return screenShare is map
        && screenShare.keys().hasOnly(['status', 'shareId', 'startedAtIso'])
        && screenShare.keys().hasAll(['status', 'shareId'])
        && screenShare.status in ['idle', 'active']
        && screenShare.shareId is string
        && screenShare.shareId.size() <= 180
        && (
          !('startedAtIso' in screenShare)
          || (
            screenShare.startedAtIso is string
            && screenShare.startedAtIso.size() <= 40
          )
        )
        && (
          (screenShare.status == 'idle' && screenShare.shareId == '')
          || (screenShare.status == 'active' && screenShare.shareId != '')
        );
    }

    function validLiveLessonSummaryV1(summary) {
      return summary is map
        && summary.keys().hasOnly([
          'teacherComment',
          'achievedGoals',
          'nextHomework',
          'homeworkDue',
          'homeworkId'
        ])
        && summary.keys().hasAll([
          'teacherComment',
          'achievedGoals',
          'nextHomework',
          'homeworkDue',
          'homeworkId'
        ])
        && summary.teacherComment is string
        && summary.teacherComment.size() > 0
        && summary.teacherComment.size() <= 3000
        && summary.achievedGoals is list
        && summary.achievedGoals.size() <= 12
        && summary.nextHomework is string
        && summary.nextHomework.size() <= 2000
        && summary.homeworkDue is string
        && summary.homeworkDue.size() <= 10
        && (
          summary.homeworkDue == ''
          || summary.homeworkDue.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        && summary.homeworkId is string
        && summary.homeworkId.size() <= 180
        && (
          (
            summary.nextHomework == ''
            && summary.homeworkDue == ''
            && summary.homeworkId == ''
          )
          || (
            summary.nextHomework != ''
            && summary.homeworkId != ''
          )
        );
    }

    function validLiveLessonSummaryV2(summary) {
      return summary is map
        && summary.keys().hasOnly([
          'teacherComment',
          'achievedGoals',
          'curriculumGoalIds',
          'curriculumGoalLabels',
          'curriculumSkillIds',
          'curriculumSubject',
          'curriculumLevel',
          'nextHomework',
          'homeworkDue',
          'homeworkId'
        ])
        && summary.keys().hasAll([
          'teacherComment',
          'achievedGoals',
          'curriculumGoalIds',
          'curriculumGoalLabels',
          'curriculumSkillIds',
          'curriculumSubject',
          'curriculumLevel',
          'nextHomework',
          'homeworkDue',
          'homeworkId'
        ])
        && summary.teacherComment is string
        && summary.teacherComment.size() > 0
        && summary.teacherComment.size() <= 3000
        && summary.achievedGoals is list
        && summary.achievedGoals.size() <= 12
        && summary.curriculumGoalIds is list
        && summary.curriculumGoalIds.size() <= 12
        && summary.curriculumGoalLabels is list
        && summary.curriculumGoalLabels.size()
          == summary.curriculumGoalIds.size()
        && summary.curriculumSkillIds is list
        && summary.curriculumSkillIds.size() <= 48
        && summary.curriculumSubject is string
        && summary.curriculumSubject.size() <= 80
        && summary.curriculumLevel is string
        && summary.curriculumLevel.size() <= 40
        && (
          (
            summary.curriculumGoalIds.size() == 0
            && summary.curriculumSkillIds.size() == 0
          )
          || (
            summary.curriculumGoalIds.size() > 0
            && summary.curriculumSkillIds.size() > 0
            && summary.curriculumSubject != ''
            && summary.curriculumLevel != ''
          )
        )
        && summary.nextHomework is string
        && summary.nextHomework.size() <= 2000
        && summary.homeworkDue is string
        && summary.homeworkDue.size() <= 10
        && (
          summary.homeworkDue == ''
          || summary.homeworkDue.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        && summary.homeworkId is string
        && summary.homeworkId.size() <= 180
        && (
          (
            summary.nextHomework == ''
            && summary.homeworkDue == ''
            && summary.homeworkId == ''
          )
          || (
            summary.nextHomework != ''
            && summary.homeworkId != ''
          )
        );
    }

    function liveLessonProgressMatches(classroomId, studentId, summary) {
      return summary.curriculumGoalIds.size() == 0
        || (
          existsAfter(studentPath(studentId))
          && getAfter(studentPath(studentId)).data.lastLiveLessonId
            == classroomId
          && getAfter(studentPath(studentId)).data.lastCurriculumGoalIds
            == summary.curriculumGoalIds
          && getAfter(studentPath(studentId)).data.lastCurriculumSkillIds
            == summary.curriculumSkillIds
        );
    }

    function liveLessonHomeworkMatches(classroomId, studentId, summary) {
      return summary.homeworkId == ''
        || (
          existsAfter(
            /databases/$(database)/documents/homework/$(summary.homeworkId)
          )
          && getAfter(
            /databases/$(database)/documents/homework/$(summary.homeworkId)
          ).data.studentId == studentId
          && getAfter(
            /databases/$(database)/documents/homework/$(summary.homeworkId)
          ).data.sourceType == 'live_classroom'
          && getAfter(
            /databases/$(database)/documents/homework/$(summary.homeworkId)
          ).data.sourceRoomId == classroomId
          && getAfter(
            /databases/$(database)/documents/homework/$(summary.homeworkId)
          ).data.task == summary.nextHomework
        );
    }

    // fields of the teacher's check of a student's work (grade, feedback, skill-map movement)
    function teacherReviewFields() {
      return ['teacherGrade', 'teacherFeedback', 'reviewedAt', 'reviewedBy', 'reviewedByName',
        'skillGrades', 'skillDeltas', 'skillCreated', 'seenByTeacher', 'annotations'];
    }

    function ownsInvoice(invoice) {
      return signedIn()
        && (
          (invoice.studentId is string && invoice.studentId != '' && ownsStudent(invoice.studentId))
          || invoice.parentUid == uid()
          || invoice.linkedParentId == uid()
          || invoice.guardianUid == uid()
          || (
            request.auth.token.email_verified == true
            && (
              (invoice.parentEmailLower is string && invoice.parentEmailLower == email())
              || (invoice.payerEmailLower is string && invoice.payerEmailLower == email())
              || (invoice.parentEmail is string && invoice.parentEmail.lower() == email())
              || (invoice.payerEmail is string && invoice.payerEmail.lower() == email())
            )
          )
        );
    }

    function changesInvoiceFinancialSource() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'amount',
        'amountCents',
        'lessonCount',
        'lessonPrice',
        'lessonPriceCents',
        'lessonIds',
        'lines',
        'lineVersion',
        'billingMode',
        'pricingMode',
        'tariffIds',
        'tariffAssignmentIds',
        'creationSignature',
        'creditedAmount',
        'creditedAmountCents',
        'effectiveAmount',
        'effectiveAmountCents',
        'correctedLessonIds',
        'creditNoteIds',
        'corrections',
        'correctionStatus',
        'overpaymentResolutionIds',
        'lastOverpaymentResolvedAt'
      ]);
    }

    function changesLessonBillingSource() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'billingStatus',
        'invoiceId',
        'invoiceNum',
        'invoiceLineIndex',
        'billedAmount',
        'billedAmountCents',
        'pricingSource',
        'billedTariffId',
        'billedTariffName',
        'billedTariffAssignmentId',
        'invoicedAt',
        'billingUpdatedAt',
        'billingDispositionReason',
        'billingUpdatedBy',
        'creditNoteId',
        'creditNoteNum',
        'creditedAt',
        'creditReason',
        'directPaymentId',
        'directPaymentAmount',
        'directPaymentAmountCents',
        'directPaidAt',
        'bankTransactionId',
        'sourceCreditId',
        'financialUpdatedAt'
      ]);
    }

    function changesLessonBillingBasis() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'studentId',
        'date',
        'duration',
        'status'
      ]);
    }

    function createsNoLessonPackageSource() {
      return !request.resource.data.keys().hasAny([
        'packageAccountingSource',
        'packageConsumptionStatus',
        'packageStudentPackageId',
        'packageProductName',
        'packageConsumptionEntryId',
        'packageRestorationEntryId',
        'packageConsumptionCycle',
        'packageSyncError',
        'packageSyncedAt'
      ]);
    }

    function changesLessonPackageSource() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'packageAccountingSource',
        'packageConsumptionStatus',
        'packageStudentPackageId',
        'packageProductName',
        'packageConsumptionEntryId',
        'packageRestorationEntryId',
        'packageConsumptionCycle',
        'packageSyncError',
        'packageSyncedAt'
      ]);
    }

    function changesStudentTariffSource() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'latestTariffAssignmentId',
        'latestTariffId',
        'latestTariffName',
        'latestTariffUnitPriceCents',
        'latestTariffUnitPrice',
        'latestTariffEffectiveFrom',
        'tariffUpdatedAt'
      ]);
    }

    function changesStudentOwnership() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'teacher',
        'linkedUserId',
        'studentUid',
        'linkedUserIds',
        'linkedParentId',
        'parentUid',
        'guardianUid',
        'linkedParentIds'
      ]);
    }

    function safeSelfUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'email',
        'childName',
        'preferredTeacher',
        'phone',
        'updatedAt',
        'parentReviewStatus',
        'parentReviewKey',
        'termsAcceptedAt',
        'termsVersion',
        'pet',
        'lastSeenAt',
        'practice'
      ])
        && validTermsAcceptance(request.resource.data)
        && validPet(request.resource.data)
        && validPresence(request.resource.data)
        // stars spent on outfits never go back down, bought items are never lost
        && request.resource.data.get('pet', {}).get('spentStars', 0) >= resource.data.get('pet', {}).get('spentStars', 0)
        && request.resource.data.get('pet', {}).get('owned', []).hasAll(resource.data.get('pet', {}).get('owned', []));
    }

    // Student cabinet pet: the chosen kind and a short name plus three own flags; growth is derived, never stored.
    // playedAt: the last word game (care only, gives no xp or stars).
    // the teacher sees when the student was last in the CRM and his last „Minu vead” review (owner 2026-10-23):
    // the visit time is always the server's, the review is a small map with the last result and recent practice days
    function validPresence(data) {
      return (
          !('lastSeenAt' in data)
          || data.lastSeenAt == resource.data.get('lastSeenAt', null)
          || data.lastSeenAt == request.time
        )
        && (
          !('practice' in data)
          || (
            data.practice is map
            && data.practice.keys().hasOnly(['errorsDate', 'errorsPct', 'days'])
            && (!('errorsDate' in data.practice) || (data.practice.errorsDate is string && data.practice.errorsDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && (!('errorsPct' in data.practice) || (data.practice.errorsPct is int && data.practice.errorsPct >= 0 && data.practice.errorsPct <= 100))
            && (!('days' in data.practice) || (data.practice.days is list && data.practice.days.size() <= 60))
          )
        );
    }

    function validPet(data) {
      return !('pet' in data)
        || (
          data.pet is map
          && data.pet.keys().hasOnly(['kind', 'name', 'chosenAt', 'tourDoneAt', 'hidden', 'optedOut', 'owned', 'wearing', 'spentStars', 'playedAt'])
          && (!('owned' in data.pet) || (data.pet.owned is list && data.pet.owned.size() <= 40))
          && (!('wearing' in data.pet) || (data.pet.wearing is map && data.pet.wearing.keys().hasOnly(['bg', 'hat', 'glasses', 'neck'])))
          && (!('spentStars' in data.pet) || (data.pet.spentStars is int && data.pet.spentStars >= 0 && data.pet.spentStars <= 100000))
          && (('kind' in data.pet) == ('name' in data.pet))
          && (!('kind' in data.pet) || data.pet.kind in ['siil', 'rebane', 'kakk', 'draakon'])
          && (!('name' in data.pet) || (data.pet.name is string && data.pet.name.size() > 0 && data.pet.name.size() <= 24))
          && (!('chosenAt' in data.pet) || (data.pet.chosenAt is string && data.pet.chosenAt.size() <= 40))
          && (!('tourDoneAt' in data.pet) || (data.pet.tourDoneAt is string && data.pet.tourDoneAt.size() <= 40))
          && (!('playedAt' in data.pet) || (data.pet.playedAt is string && data.pet.playedAt.size() <= 40))
          && (!('hidden' in data.pet) || data.pet.hidden is bool)
          && (!('optedOut' in data.pet) || data.pet.optedOut is bool)
        );
    }

    function validTermsAcceptance(data) {
      return (
          !('termsAcceptedAt' in data)
          || (
            data.termsAcceptedAt is string
            && data.termsAcceptedAt.size() >= 10
            && data.termsAcceptedAt.size() <= 40
          )
        )
        && (
          !('termsVersion' in data)
          || (
            data.termsVersion is string
            && data.termsVersion.matches('^\\d{4}-\\d{2}-\\d{2}$')
          )
        );
    }

    function safeSelfUserCreate() {
      return request.resource.data.keys().hasOnly([
          'role',
          'displayName',
          'email',
          'childName',
          'preferredTeacher',
          'phone',
          'parentPhone',
          'createdAt',
          'updatedAt',
          'parentReviewStatus',
          'parentReviewKey',
          'termsAcceptedAt',
          'termsVersion',
          'approvalStatus'
        ])
        && request.resource.data.keys().hasAll([
          'role',
          'displayName',
          'email',
          'createdAt',
          'approvalStatus'
        ])
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.role in ['parent', 'student']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 160
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 320
        && validTermsAcceptance(request.resource.data);
    }

    match /users/{userId} {
      // A waiting account may read its own profile (to show "waiting for approval"), nothing else; disabled ones not even that.
      // a new account reads its profile before it exists (registration): that read is allowed, not an evaluation error
      allow read: if (request.auth != null && uid() == userId && (resource == null || resource.data.get('disabled', false) != true)) || isStaff();
      allow create: if signedIn()
        && uid() == userId
        && safeSelfUserCreate();
      allow update: if isAdmin() || (signedIn() && uid() == userId && safeSelfUserFields());
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      // List queries must be provable from the candidate document itself. Calling
      // ownsStudent(studentId) here performs a get() and makes an otherwise safe
      // `where('linkedUserId', '==', uid)` query fail as permission-denied.
      allow read: if isAdmin() || teacherCanRead(resource.data) || ownsStudentProfile(studentId, resource.data);
      // Student and parent onboarding is performed by the protected server
      // bootstrap so an old cached browser cannot create duplicate cards.
      allow create: if isAdmin() || teacherCanCreate(request.resource.data);
      allow update: if (
          isAdmin()
          && !changesStudentTariffSource()
        )
        || (
          teacherCanUpdate(resource.data, request.resource.data)
          && !changesStudentOwnership()
          && !changesStudentTariffSource()
          // the student's Facebook / Instagram contact is kept by the admin
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['facebook', 'instagram'])
        )
        || (
          ownsStudent(studentId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email',
            'phone',
            'parentName',
            'parentEmail',
            'contactEmail',
            'guardianEmail',
            'updatedAt'
          ])
          // the skill map is the teacher's assessment (checked works, lessons): a student or parent cannot change it
        )
        // lesson recording consent: the student (or the linked parent) answers once on first login, signed with
        // their own uid; they can change it later. Staff keep setting it from the student card.
        || (
          ownsStudent(studentId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'recordingConsent',
            'recordingConsentAt',
            'recordingConsentBy',
            'recordingConsentByUid'
          ])
          && request.resource.data.recordingConsent is bool
          && request.resource.data.recordingConsentByUid == uid()
          && request.resource.data.recordingConsentAt is string
          && request.resource.data.recordingConsentBy is string
          && request.resource.data.recordingConsentBy.size() <= 200
        );
      allow delete: if isAdmin();
    }

    match /studentInitialAssessments/{studentId} {
      allow read: if isAdmin()
        || (
          isTeacher()
          && exists(studentPath(studentId))
          && teacherCanRead(studentDoc(studentId))
        )
        || ownsStudent(studentId);
      allow create: if validInitialAssessment(request.resource.data, studentId)
        && (
          isAdmin()
          || (
            isTeacher()
            && exists(studentPath(studentId))
            && teacherCanRead(studentDoc(studentId))
          )
        );
      allow update: if validInitialAssessment(request.resource.data, studentId)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && (
          isAdmin()
          || (
            isTeacher()
            && exists(studentPath(studentId))
            && teacherCanRead(studentDoc(studentId))
          )
        );
      allow delete: if isAdmin();
    }

    match /schedule/{scheduleId} {
      allow read: if isAdmin() || teacherCanRead(resource.data) || ownsStudent(resource.data.studentId);
      allow create: if isAdmin() || teacherCanCreate(request.resource.data);
      allow update: if isAdmin() || teacherCanUpdate(resource.data, request.resource.data);
      allow delete: if isAdmin() || teacherCanUpdate(resource.data, resource.data);
    }

    // the administrator's note on a calendar lesson (Oleksiy 2026-10-15): the administrator writes, the administrator
    // and the lesson's teacher read; never students or parents (they can read their own schedule entries)
    // rooms („Kabinet”, Oleksiy 2026-10-15): the administrator keeps the list; every staff member reads it and the
    // room bookings (written only by the server trigger syncRoomBooking, no student data)
    match /classrooms/{roomId} {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'active', 'order', 'updatedAt', 'updatedBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
    }
    match /roomBookings/{scheduleId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /lessonNotes/{noteId} {
      allow read: if isAdmin() || (isStaff() && resource.data.teacherUid == uid());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['scheduleId', 'date', 'teacherUid', 'studentName', 'text', 'updatedAt', 'updatedBy', 'updatedByName'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.updatedBy == uid();
      allow delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      // marking a lesson first reads its id (the transaction makes sure it is not marked twice): a teacher reading a
      // lesson that does not exist yet is allowed, not an evaluation error (owner 2026-10-14, Yelyzaveta Lukiianchuk)
      allow read: if isAdmin() || (resource == null && isStaff()) || teacherCanRead(resource.data) || ownsStudent(resource.data.studentId);
      allow create: if (isAdmin() || teacherCanCreate(request.resource.data))
        && createsNoLessonPackageSource()
        && financialDateOpen(request.resource.data.get('date', ''));
      allow update: if (isAdmin() || teacherCanUpdate(resource.data, request.resource.data))
        && financialDateOpen(resource.data.get('date', ''))
        && financialDateOpen(request.resource.data.get('date', ''))
        && !changesLessonBillingSource()
        && !changesLessonPackageSource()
        && (
          resource.data.get('accountingSource', '') == 'crm_v2'
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
        )
        // Finance v2: "don't charge this no-show" is an admin decision
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['billingWaived', 'billingWaivedBy', 'billingWaivedAt']))
        // "held and checked" is set and cleared only by an admin
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'verifiedAt', 'verifiedByUid', 'verifiedByName']))
        && (
          !changesLessonBillingBasis()
          || (
            (
              !resource.data.keys().hasAny(['invoiceId'])
              || resource.data.invoiceId == ''
            )
            && (
              !resource.data.keys().hasAny(['billingStatus'])
              || resource.data.billingStatus == ''
            )
          )
        );
      allow delete: if (isAdmin() || teacherCanUpdate(resource.data, resource.data))
        && financialDateOpen(resource.data.get('date', ''))
        && (
          !resource.data.keys().hasAny(['invoiceId'])
          || resource.data.invoiceId == ''
        )
        && (
          !resource.data.keys().hasAny(['billingStatus'])
          || resource.data.billingStatus == ''
        )
        && (
          !resource.data.keys().hasAny(['packageConsumptionStatus'])
          || resource.data.packageConsumptionStatus != 'consumed'
        );
    }

    match /homework/{homeworkId} {
      allow read: if staffCanAccessStudent(resource.data.studentId) || ownsStudent(resource.data.studentId);
      allow create: if staffCanAccessStudent(request.resource.data.get('studentId', ''));
      allow update: if (staffCanAccessStudent(resource.data.studentId) && staffCanAccessStudent(request.resource.data.get('studentId', '')))
        || (
          ownsStudent(resource.data.studentId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'fileUrl',
            'fileName',
            'attachments',
            'submittedAt',
            'updatedAt',
            'fileRemovedAt',
            'fileRemovedBy',
            'studentAnswer',
            'studentFiles'
          ])
          // the student's answer with „Tehtud”: a short text and up to 10 files
          && (!('studentAnswer' in request.resource.data) || (request.resource.data.studentAnswer is string && request.resource.data.studentAnswer.size() <= 4000))
          && (!('studentFiles' in request.resource.data) || (request.resource.data.studentFiles is list && request.resource.data.studentFiles.size() <= 10))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['Ootel', 'Tehtud'])
        );
      allow delete: if staffCanAccessStudent(resource.data.studentId);
    }

    match /invoices/{invoiceId} {
      // Teachers only mark lessons; money is the administrator's and the bookkeeper's (owner decision 2026-10-11).
      allow read: if isAdmin() || isFinance() || ownsInvoice(resource.data);
      // invoices are made by the finance functions (CRM v2); a direct create is left to the administrator (old haldus)
      allow create: if isAdmin() && financialDateOpen(request.resource.data.get('date', ''));
      allow update: if isAdmin()
        && !changesInvoiceFinancialSource()
        && financialDateOpen(resource.data.get('date', ''))
        && financialDateOpen(request.resource.data.get('date', ''));
      allow delete: if isAdmin()
        && financialDateOpen(resource.data.get('date', ''))
        && (
          !resource.data.keys().hasAny(['paymentCount'])
          || resource.data.paymentCount == 0
        )
        && (
          !resource.data.keys().hasAny(['lessonIds'])
          || resource.data.lessonIds.size() == 0
        );
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /paymentLineAllocations/{allocationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /financialAudit/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // bookkeeping (functions/accounting-core.js, RPS §§ 6–12): written only by financeApi; a correction while the
    // period is open keeps its history on the entry (a deleted manual entry stays as a tombstone), after the lock it is
    // a storno / correcting entry
    match /accountingEntries/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /accountingAccounts/{code} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // „Sulge periood kuni …” (accountingSettings/lock), suppliers and purchase invoices (functions/purchases-core.js):
    // admin read, written only by financeApi
    match /accountingSettings/{settingId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /suppliers/{supplierId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /purchaseInvoices/{purchaseInvoiceId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // personal codes for INF 3 (functions/inf3-core.js): admin read only, written by financeApi and taxFormApi
    match /taxIdentities/{studentId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // a parent's payer code for INF 3, shared by all their children (functions/inf3-core.js payerKeyOf)
    match /taxPayers/{payerKey} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /taxFormTokens/{token} {
      allow read, create, update, delete: if false;
    }
    // cash box (functions/cash-core.js): written only by financeApi; teachers see their own part through /cash/summary
    match /cashLedger/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /invoiceNumberRepairs/{repairId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /financialPeriods/{monthId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /financialPeriodReviews/{reviewId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /financialPeriodExports/{exportId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /financialPeriodClosures/{closureId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /financialPeriodCorrections/{correctionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /financialLockedDates/{dateId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /bankTransactions/{transactionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /payerCredits/{creditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /creditApplications/{applicationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /creditNotes/{creditNoteId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /overpaymentResolutions/{resolutionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /refunds/{refundId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /tariffs/{tariffId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /studentTariffAssignments/{assignmentId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /studentRevenuePlans/{studentId} {
      allow read: if isAdmin() || isFinance();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'studentId',
          'studentName',
          'lessonPriceCents',
          'weeklyLessons',
          'currency',
          'active',
          'updatedAt',
          'updatedBy',
          'updatedByUid',
          'lessonMinutes',
          'billingMode',
          'chargeNoShow',
          'validFrom',
          'priceHistory',
          'subjectPrices'
        ])
        // the price of a second subject of the card (owner 2026-10-20): { "Matemaatika": { lessonPriceCents, lessonMinutes } }
        && (!('subjectPrices' in request.resource.data) || (request.resource.data.subjectPrices is map && request.resource.data.subjectPrices.size() <= 8))
        && request.resource.data.keys().hasAll([
          'studentId',
          'studentName',
          'lessonPriceCents',
          'weeklyLessons',
          'currency',
          'active',
          'updatedAt',
          'updatedByUid'
        ])
        && request.resource.data.studentId == studentId
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 160
        && request.resource.data.lessonPriceCents is int
        && request.resource.data.lessonPriceCents > 0
        && request.resource.data.lessonPriceCents <= 1000000
        && request.resource.data.weeklyLessons is number
        && request.resource.data.weeklyLessons >= 0.5
        && request.resource.data.weeklyLessons <= 50
        && request.resource.data.currency == 'EUR'
        && request.resource.data.active == true
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedByUid == uid()
        // billing settings (Finance v2): lesson length, advance / current-month billing, no-show charge, price history
        && (!('lessonMinutes' in request.resource.data) || request.resource.data.lessonMinutes in [30, 45, 60, 75, 90, 120])
        && (!('billingMode' in request.resource.data) || request.resource.data.billingMode in ['advance', 'current', 'actual'])
        && (!('chargeNoShow' in request.resource.data) || request.resource.data.chargeNoShow is bool)
        && (!('validFrom' in request.resource.data) || (request.resource.data.validFrom is string && request.resource.data.validFrom.size() == 10))
        && (!('priceHistory' in request.resource.data) || (request.resource.data.priceHistory is list && request.resource.data.priceHistory.size() <= 60));
      allow delete: if isAdmin();
    }

    // Personal codes used for annual tax declarations are intentionally kept
    // outside ordinary student/user profiles. They are visible only to admins.
    match /taxPersonProfiles/{profileId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'entityType',
          'entityId',
          'displayName',
          'personalCode',
          'updatedAt',
          'updatedByUid',
          'updatedByName'
        ])
        && request.resource.data.keys().hasAll([
          'entityType',
          'entityId',
          'displayName',
          'personalCode',
          'updatedAt',
          'updatedByUid'
        ])
        && request.resource.data.entityType in ['student', 'user', 'payer']
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.entityId.size() <= 320
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 160
        && request.resource.data.personalCode is string
        && request.resource.data.personalCode.matches('^[0-9]{11}$')
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedByUid == uid();
      allow delete: if false;
    }

    match /packageProducts/{productId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // lesson tokens (functions/lesson-tokens-core.js): finance and the card's own student / parent see the balance
    match /studentPackages/{packageId} {
      allow read: if isAdmin() || isFinance() || ownsStudent(resource.data.studentId);
      allow create, update, delete: if false;
    }

    match /packageLedger/{entryId} {
      allow read: if isAdmin() || isFinance() || ownsStudent(resource.data.studentId);
      allow create, update, delete: if false;
    }

    match /lessonPackageStates/{lessonId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /lessonPackageSyncRequests/{requestId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if staffCanAccessStudent(resource.data.get('studentId', '')) || ownsStudent(resource.data.studentId);
      allow create: if staffCanAccessStudent(request.resource.data.get('studentId', ''))
        || (
          ownsStudent(request.resource.data.studentId)
          && request.resource.data.get('fromUid', '') == uid()
          && request.resource.data.get('fromRole', '') in ['', 'student', 'parent']
        );
      allow update: if (staffCanAccessStudent(resource.data.get('studentId', '')) && request.resource.data.get('studentId', '') == resource.data.get('studentId', ''))
        || (
          ownsStudent(resource.data.studentId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        );
      allow delete: if isAdmin();
    }

    // „Sobivad ajad” on a student's card (owner 2026-10-21): the student or the parent writes their own; the
    // administrator writes any and marks it reviewed; the student's teacher reads it
    function availabilityValid(data, studentId) {
      return data.keys().hasOnly(['studentId', 'slots', 'preferred', 'message', 'changedAt', 'changedByUid', 'changedByName',
          'changedByRole', 'previousSlots', 'previousPreferred', 'updatedAt', 'reviewedAt', 'reviewedByName', 'weeks', 'perWeek'])
        && data.studentId == studentId
        // lessons a week the learner wants, per course (owner 2026-10-29): { 'eesti-keel': 2 }, at most 10 courses
        && (!('perWeek' in data) || (data.perWeek is map && data.perWeek.size() <= 10))
        // dated weeks that differ from the usual one (owner 2026-10-29), at most 8: { 'YYYY-MM-DD': { slots, preferred } }
        && (!('weeks' in data) || (data.weeks is map && data.weeks.size() <= 8))
        && data.slots is list && data.slots.size() <= 336
        && data.preferred is list && data.preferred.size() <= 336
        && (!('message' in data) || (data.message is string && data.message.size() <= 1000))
        && (!('previousSlots' in data) || (data.previousSlots is list && data.previousSlots.size() <= 336))
        && (!('previousPreferred' in data) || (data.previousPreferred is list && data.previousPreferred.size() <= 336));
    }
    match /studentAvailability/{studentId} {
      allow read: if isAdmin() || staffCanAccessStudent(studentId) || ownsStudent(studentId);
      allow create: if availabilityValid(request.resource.data, studentId)
        && (isAdmin() || (ownsStudent(studentId) && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewedByName'])
          && request.resource.data.changedByUid == uid()));
      allow update: if availabilityValid(request.resource.data, studentId)
        && (isAdmin() || (ownsStudent(studentId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedAt', 'reviewedByName'])
          && request.resource.data.changedByUid == uid()));
      allow delete: if isAdmin();
    }

    // „Teated” (owner 2026-10-24): the administrator's announcements that a student / parent must read or answer
    // before using the CRM. Only the administrator reads and writes them here; learners get their own announcements
    // and send answers through staffOperationsApi /announcements/* (functions/announcements-service.js), which
    // matches the audience on the server — so no learner can list announcements or answers meant for others.
    function announcementValid(data) {
      return data.keys().hasOnly(['title', 'body', 'audience', 'subjects', 'levels', 'studentIds', 'activeFrom', 'activeTo',
          'responseType', 'question', 'allowChange', 'status', 'createdAt', 'createdByUid', 'createdByName', 'updatedAt',
          'updatedByUid', 'publishedAt', 'archivedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.body is string && data.body.size() <= 5000
        && data.audience in ['students', 'parents', 'both']
        && data.subjects is list && data.subjects.size() <= 20
        && data.levels is list && data.levels.size() <= 20
        && data.studentIds is list && data.studentIds.size() <= 500
        && data.activeFrom is string && data.activeFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.activeTo is string && (data.activeTo == '' || (data.activeTo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.activeTo >= data.activeFrom))
        && data.responseType in ['read', 'question', 'availability']
        && data.question is map && data.question.keys().hasOnly(['mode', 'options', 'allowOther'])
        && data.question.get('mode', 'text') in ['text', 'single', 'multiple']
        && data.question.get('options', []) is list && data.question.get('options', []).size() <= 12
        && data.allowChange is bool
        && data.status in ['draft', 'published', 'archived'];
    }
    match /announcements/{announcementId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && announcementValid(request.resource.data) && request.resource.data.createdByUid == uid();
      allow update: if isAdmin() && announcementValid(request.resource.data)
        && request.resource.data.createdByUid == resource.data.createdByUid;
      // archived, never deleted: the answers keep pointing to it
      allow delete: if false;
    }
    match /announcementResponses/{responseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // „Puuduvad andmed” (owner 2026-10-25): which items a student / parent is asked after login and which of them
    // block the CRM. Only the administrator reads and writes the setting; learners get their questions and send their
    // answers through staffOperationsApi /missing-data/* (functions/missing-data-service.js), which writes only the
    // missing fields of the caller's own cards and an audit record here — no learner writes these collections.
    function missingDataModeValid(items, key) {
      return !(key in items) || items[key] in ['required', 'optional', 'off'];
    }
    match /missingDataSettings/{settingId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && settingId == 'current'
        && request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedByUid'])
        && request.resource.data.items is map
        && request.resource.data.items.keys().hasOnly(['availability', 'email', 'phone', 'parentName', 'language', 'grade'])
        && missingDataModeValid(request.resource.data.items, 'availability')
        && missingDataModeValid(request.resource.data.items, 'email')
        && missingDataModeValid(request.resource.data.items, 'phone')
        && missingDataModeValid(request.resource.data.items, 'parentName')
        && missingDataModeValid(request.resource.data.items, 'language')
        && missingDataModeValid(request.resource.data.items, 'grade')
        && request.resource.data.updatedByUid == uid();
      allow delete: if false;
    }
    match /missingDataSubmissions/{submissionId} {
      allow read: if isAdmin();
      // the administrator only marks a submission as seen; the record itself is written by the server
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewedAt', 'reviewedByUid', 'reviewedByName'])
        && request.resource.data.reviewedByUid == uid()
        && request.resource.data.reviewedAt is string && request.resource.data.reviewedAt.size() > 0;
      allow create, delete: if false;
    }

    match /websiteLeads/{leadId} {
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'contactOwner', 'contactLastAt', 'contactNotes']);
      allow create, delete: if false;
    }

    match /websiteLeadThrottle/{throttleId} {
      allow read, write: if false;
    }

    // „Õpi ise” (owner 2026-10-12): a student opens a course lesson's sheet on his own — only for his own card, as
    // 'self_study', unscored and new, with the sheet exactly as published in the course (nothing of his own in it)
    function selfStudySheet(data) {
      return ownsStudent(data.studentId)
        && data.keys().hasOnly(['lessonId', 'lessonTitle', 'phase', 'subject', 'level', 'topic', 'worksheetDoc', 'files',
          'studentId', 'studentName', 'assignedBy', 'assignedByName', 'assignedAt', 'dueDate', 'note', 'status', 'score',
          'completedAt', 'answers', 'source'])
        && data.source == 'self_study'
        && data.status == 'new'
        && data.assignedBy == uid()
        && data.get('score', null) == null
        && data.get('completedAt', '') == ''
        && data.get('answers', {}) == {}
        && data.phase in ['discover', 'practice', 'transfer']
        && data.lessonId is string
        && data.worksheetDoc == get(/databases/$(database)/documents/curriculumLessons/$(data.lessonId)/worksheets/$(data.phase)).data.publishedWorksheetDoc;
    }

    match /worksheetAssignments/{assignmentId} {
      allow read: if staffCanAccessStudent(resource.data.studentId) || ownsStudent(resource.data.studentId) || liveGuestRoomSheet(resource.data);
      allow create: if (staffCanAccessStudent(request.resource.data.get('studentId', ''))
        && (
          request.resource.data.get('source', '') != 'student_private_worksheet'
          || (
            getAfter(/databases/$(database)/documents/studentWorksheetDrafts/$(assignmentId)).data.studentId == request.resource.data.studentId
          )
        ))
        || selfStudySheet(request.resource.data);
      allow delete: if staffCanAccessStudent(resource.data.studentId);
      allow update: if request.resource.data.studentId == resource.data.studentId
        && (staffCanAccessStudent(resource.data.studentId)
        || (
          (ownsStudent(resource.data.studentId) || liveGuestRoomSheet(resource.data))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'answers',
            'score',
            'errorLog',
            'completedAt',
            'seenByTeacher',
            'selfAssessment',
            'updatedAt'
          ])
        ));
    }

    // Personal Worksheet Studio drafts stay outside the shared curriculum library.
    // The student sees only the published snapshot in worksheetAssignments.
    match /studentWorksheetDrafts/{draftId} {
      allow read: if isAdmin() || (isTeacher() && teacherCanRead(studentDoc(resource.data.studentId)));
      allow create: if request.resource.data.studentId is string
        && exists(studentPath(request.resource.data.studentId))
        && (isAdmin() || (isTeacher() && teacherCanRead(studentDoc(request.resource.data.studentId))));
      allow update: if request.resource.data.studentId == resource.data.studentId
        && (isAdmin() || (isTeacher() && teacherCanRead(studentDoc(resource.data.studentId))));
      allow delete: if isAdmin() || (isTeacher() && teacherCanRead(studentDoc(resource.data.studentId)));
    }

    match /exerciseResults/{resultId} {
      allow read: if staffCanAccessStudent(resource.data.get('studentId', '')) || ownsStudent(resource.data.studentId);
      allow create: if staffCanAccessStudent(request.resource.data.get('studentId', ''))
        || (
          ownsStudent(request.resource.data.studentId)
          && !request.resource.data.keys().hasAny(teacherReviewFields())
          && request.resource.data.get('reviewStatus', 'pending') == 'pending'
        );
      allow update: if (staffCanAccessStudent(resource.data.get('studentId', '')) && request.resource.data.get('studentId', '') == resource.data.get('studentId', ''))
        || (
          ownsStudent(resource.data.studentId)
          && request.resource.data.studentId == resource.data.studentId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(teacherReviewFields())
          && request.resource.data.get('reviewStatus', 'pending') == 'pending'
        );
      allow delete: if isAdmin();
    }

    // Lesson recordings from the Live Classroom room. The teacher of an accepted invitation starts one only when
    // the student card has recordingConsent == true; the browser appends audio segments; the transcription worker
    // (Admin SDK on the school Mac) writes the text. Teacher, student and admin may read; nobody else.
    // The school's picture and text bank for the worksheet constructor (staff only).
    match /mediaAssets/{assetId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly([
          'kind', 'level', 'topic', 'sheetTitle', 'lessonId', 'phase', 'tags', 'source',
          'src', 'storagePath', 'width', 'height', 'caption', 'credit',
          'title', 'text', 'words', 'textType',
          'createdAt', 'createdBy', 'createdByName', 'updatedAt'
        ])
        && request.resource.data.kind in ['image', 'text']
        && request.resource.data.level in ['', 'A1', 'A2', 'B1', 'B2', 'C1']
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 60
        && (request.resource.data.kind != 'image' || (request.resource.data.src is string && request.resource.data.src.size() > 0 && request.resource.data.src.size() <= 2000))
        && (request.resource.data.kind != 'text' || (request.resource.data.text is string && request.resource.data.text.size() <= 6000));
      allow delete: if isAdmin() || (isStaff() && resource.data.createdBy == uid());
    }

    match /lessonRecordings/{recordingId} {
      // the student only sees that a lesson is being recorded right now (the room's indicator); the finished
      // recording and its transcript are for the teacher and admins only (owner, 2026-10-04)
      allow read: if isAdmin()
        || (signedIn() && resource.data.teacherUid == uid())
        || (signedIn() && resource.data.studentUid == uid() && resource.data.status == 'recording');
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly([
          'invitationId', 'teacherUid', 'teacherName', 'studentId', 'studentUid', 'studentName',
          'title', 'language', 'status', 'segments', 'startedAt', 'updatedAt'
        ])
        && request.resource.data.teacherUid == uid()
        && request.resource.data.status == 'recording'
        && request.resource.data.segments == []
        && request.resource.data.language in ['et', 'en']
        && recordingId.matches('^' + request.resource.data.invitationId + '_[0-9]+$')
        && exists(/databases/$(database)/documents/liveLessonInvitations/$(request.resource.data.invitationId))
        && get(/databases/$(database)/documents/liveLessonInvitations/$(request.resource.data.invitationId)).data.teacherUid == uid()
        && get(/databases/$(database)/documents/liveLessonInvitations/$(request.resource.data.invitationId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/liveLessonInvitations/$(request.resource.data.invitationId)).data.studentId == request.resource.data.studentId
        && get(/databases/$(database)/documents/liveLessonInvitations/$(request.resource.data.invitationId)).data.studentUid == request.resource.data.studentUid
        && exists(studentPath(request.resource.data.studentId))
        && studentDoc(request.resource.data.studentId).get('recordingConsent', false) == true;
      allow update: if isStaff()
        && resource.data.teacherUid == uid()
        && resource.data.status == 'recording'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt', 'segments', 'updatedAt', 'textRequestedAt'])
        && (!('textRequestedAt' in request.resource.data) || (request.resource.data.textRequestedAt is string && request.resource.data.textRequestedAt.size() <= 40))
        && request.resource.data.status in ['recording', 'uploaded']
        && request.resource.data.segments is list
        && request.resource.data.segments.size() <= 240;
      allow delete: if isAdmin();
    }

    // The student's own word list (Live Classroom „Sõnad”). Staff add and edit words; the student or a linked parent
    // reads them and writes only the flashcard practice fields.
    function studentWordTextValid(data) {
      return data.word is string && data.word.size() > 0 && data.word.size() <= 120
        && data.get('translation', '') is string && data.get('translation', '').size() <= 200
        && data.get('example', '') is string && data.get('example', '').size() <= 400
        && data.get('forms', '') is string && data.get('forms', '').size() <= 200
        && data.get('formItems', []) is list && data.get('formItems', []).size() <= 8;
    }
    match /studentWords/{wordId} {
      allow read: if isStaff() || ownsStudent(resource.data.studentId);
      // staff in lessons; the student (or a linked parent) from the course decks of „Sõnavara”
      allow create: if (isStaff() || ownsStudent(request.resource.data.studentId))
        && request.resource.data.keys().hasOnly(['studentId', 'invitationId', 'word', 'translation', 'example',
          'forms', 'formItems', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt', 'box', 'dueAt'])
        && request.resource.data.keys().hasAll(['studentId', 'word', 'createdByUid', 'createdAt', 'box'])
        && request.resource.data.createdByUid == uid()
        && request.resource.data.get('createdByName', '') is string
        && request.resource.data.get('createdByName', '').size() <= 160
        && request.resource.data.get('invitationId', '') is string
        && request.resource.data.get('invitationId', '').size() <= 200
        && request.resource.data.box == 0
        // a lesson link (invitationId) is only set by the teacher of the lesson
        && (isStaff() || request.resource.data.get('invitationId', '') == '')
        && studentWordTextValid(request.resource.data)
        && exists(studentPath(request.resource.data.studentId));
      allow update: if (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['word', 'translation', 'example', 'forms', 'formItems', 'updatedAt'])
          && studentWordTextValid(request.resource.data))
        || (ownsStudent(resource.data.studentId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['box', 'dueAt', 'reviewedAt', 'reviews'])
          && request.resource.data.box is int && request.resource.data.box >= 0 && request.resource.data.box <= 5
          && request.resource.data.dueAt is string && request.resource.data.dueAt.size() <= 40
          && request.resource.data.get('reviewedAt', '') is string
          && request.resource.data.get('reviews', 0) is int);
      allow delete: if isStaff();
    }

    // What the student and parents see after a Live Classroom lesson; written by the lesson's teacher when it ends.
    function lessonSummaryValid(data, invitationId) {
      let invitation = get(/databases/$(database)/documents/liveLessonInvitations/$(invitationId)).data;
      return data.keys().hasOnly(['invitationId', 'studentId', 'teacherUid', 'teacherName', 'title', 'subject',
          'startedAt', 'endedAt', 'note', 'pages', 'updatedAt'])
        && data.invitationId == invitationId
        && data.teacherUid == uid()
        && data.studentId is string
        && data.get('teacherName', '') is string && data.get('teacherName', '').size() <= 160
        && data.get('title', '') is string && data.get('title', '').size() <= 200
        && data.get('subject', '') is string && data.get('subject', '').size() <= 200
        && data.get('note', '') is string && data.get('note', '').size() <= 2000
        && data.get('pages', []) is list && data.get('pages', []).size() <= 40
        && invitation.teacherUid == uid()
        && invitation.studentId == data.studentId;
    }
    match /lessonSummaries/{invitationId} {
      allow read: if isStaff() || ownsStudent(resource.data.studentId);
      allow create: if isStaff()
        && exists(/databases/$(database)/documents/liveLessonInvitations/$(invitationId))
        && lessonSummaryValid(request.resource.data, invitationId);
      allow update: if isStaff()
        && resource.data.teacherUid == uid()
        && lessonSummaryValid(request.resource.data, invitationId);
      allow delete: if isAdmin();
    }

    // Public copy of a student's pet (kind, name, outfit) for the teacher and parents; written only by the student
    // themselves and only pointing at their own student card.
    match /petProfiles/{petUid} {
      allow read: if isStaff() || (signedIn() && uid() == petUid) || ownsStudent(resource.data.studentId);
      allow create, update: if signedIn() && uid() == petUid
        && request.resource.data.keys().hasOnly(['uid', 'studentId', 'kind', 'name', 'wearing', 'updatedAt'])
        && request.resource.data.uid == petUid
        && request.resource.data.studentId is string
        && ownsStudent(request.resource.data.studentId)
        && request.resource.data.kind in ['siil', 'rebane', 'kakk', 'draakon']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.wearing is map && request.resource.data.wearing.keys().hasOnly(['bg', 'hat', 'glasses', 'neck'])
        && request.resource.data.updatedAt is string;
      allow delete: if signedIn() && uid() == petUid;
    }

    // Heartbeat of the transcriber on the school Mac (Admin SDK). Staff see in the lesson room whether it runs.
    // „Paku laused” in the constructor: a teacher asks the school Mac (local models, nothing leaves the Mac) for
    // sentences; the Mac answers with the Admin SDK. Only the asker and admins read the answer.
    match /aiRequests/{requestId} {
      allow read: if isAdmin() || (isStaff() && resource.data.createdBy == uid());
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['kind', 'topic', 'level', 'grammar', 'count', 'words', 'text', 'createdBy', 'createdAt', 'status'])
        && request.resource.data.kind in ['sentences', 'reading', 'evaluate', 'learnerText']
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 8000))
        && (!('words' in request.resource.data) || (request.resource.data.words is int && request.resource.data.words >= 0 && request.resource.data.words <= 1000))
        && request.resource.data.status == 'new'
        && request.resource.data.createdBy == uid()
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 120
        && request.resource.data.level is string && request.resource.data.level.size() <= 10
        && request.resource.data.grammar is string && request.resource.data.grammar.size() <= 120
        && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 12
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow update, delete: if false;
    }

    // The learner's pet: the simple numbers of a recorded lesson and the learner's own corrected sentences, written by
    // the school Mac (never the teacher's AI summary). The learner reads his own; staff read them for the pet preview.
    match /petLessonStats/{lessonId} {
      allow read: if isStaff() || (signedIn() && resource.data.studentUid == uid());
      allow write: if false;
    }

    // „Halb lause”: sentences teachers marked bad; the worksheet generator skips them
    match /generatorFlags/{flagId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['text', 'lessonId', 'blockType', 'createdBy', 'createdByName', 'createdAt'])
        && request.resource.data.createdBy == uid()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.lessonId is string && request.resource.data.lessonId.size() <= 120
        && request.resource.data.blockType is string && request.resource.data.blockType.size() <= 40
        && request.resource.data.createdByName is string && request.resource.data.createdByName.size() <= 120
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /transcriberStatus/{workerId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /liveGroupRooms/{roomId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.teacherUid == uid())
        || (signedIn() && resource.data.memberUids.hasAny([uid()]));
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['teacherUid', 'teacherName', 'title', 'memberUids', 'members', 'status', 'createdAt', 'closedAt'])
        && request.resource.data.keys().hasAll(['teacherUid', 'teacherName', 'title', 'memberUids', 'members', 'status', 'createdAt', 'closedAt'])
        && request.resource.data.teacherUid == uid()
        && request.resource.data.teacherName is string && request.resource.data.teacherName.size() <= 160
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && validLiveGroupMembers(request.resource.data)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.closedAt == null;
      // the teacher changes the members while the room is open, or closes it
      allow update: if (isAdmin() || (signedIn() && resource.data.teacherUid == uid()))
        && resource.data.status == 'open'
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'status', 'closedAt', 'title'])
        && validLiveGroupMembers(request.resource.data)
        && (
          (request.resource.data.status == 'open' && request.resource.data.closedAt == null)
          || (request.resource.data.status == 'closed' && request.resource.data.closedAt == request.time)
        );
      allow delete: if isAdmin();

      // WebRTC mesh: every signal goes from one participant to one other participant
      match /signals/{signalId} {
        allow read: if liveGroupParticipant(roomId);
        allow create: if liveGroupOpenParticipant(roomId)
          && request.resource.data.keys().hasOnly(['type', 'sessionId', 'fromUid', 'toUid', 'payload', 'createdAt', 'createdAtIso'])
          && request.resource.data.keys().hasAll(['type', 'sessionId', 'fromUid', 'toUid', 'payload', 'createdAt', 'createdAtIso'])
          && request.resource.data.type in ['offer', 'answer', 'candidate', 'hangup']
          && request.resource.data.sessionId is string && request.resource.data.sessionId.size() > 0 && request.resource.data.sessionId.size() <= 120
          && request.resource.data.fromUid == uid()
          && request.resource.data.toUid is string && request.resource.data.toUid.size() > 0 && request.resource.data.toUid != uid()
          && request.resource.data.payload is string && request.resource.data.payload.size() <= 64000
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdAtIso is string;
        allow update, delete: if false;
      }

      // the lesson chat of a group room: participants write while it is open, everyone in it reads (also afterwards)
      match /messages/{messageId} {
        allow read: if liveGroupParticipant(roomId);
        allow create: if liveGroupOpenParticipant(roomId)
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'text', 'createdAt', 'createdAtIso'])
          && request.resource.data.keys().hasAll(['fromUid', 'fromName', 'text', 'createdAt', 'createdAtIso'])
          && request.resource.data.fromUid == uid()
          && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 160
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdAtIso is string;
        allow update, delete: if false;
      }

      match /presence/{presenceId} {
        allow read: if liveGroupParticipant(roomId);
        allow create, update: if liveGroupOpenParticipant(roomId)
          && presenceId == uid()
          && request.resource.data.keys().hasOnly(['uid', 'role', 'displayName', 'online', 'lastSeen', 'lastSeenIso'])
          && request.resource.data.keys().hasAll(['uid', 'role', 'displayName', 'online', 'lastSeen', 'lastSeenIso'])
          && request.resource.data.uid == uid()
          && (
            (request.resource.data.role == 'teacher' && get(liveGroupRoomPath(roomId)).data.teacherUid == uid())
            || (request.resource.data.role == 'student' && get(liveGroupRoomPath(roomId)).data.memberUids.hasAny([uid()]))
          )
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 160
          && request.resource.data.online is bool
          && request.resource.data.lastSeen == request.time
          && request.resource.data.lastSeenIso is string;
        allow delete: if false;
      }
    }

    // The group board of a group room: everyone in the room draws and writes; teacher materials (images/PDFs) stay
    // staff-only like on a student's board.
    match /groupBoards/{roomId} {
      allow read: if liveGroupParticipant(roomId);
      allow create, update: if liveGroupParticipant(roomId)
        && request.resource.data.updatedByUid == uid()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'updatedAt', 'updatedByUid', 'updatedByName', 'lastClientId', 'backgrounds'])
        && (!('backgrounds' in request.resource.data) || (request.resource.data.backgrounds is map && request.resource.data.backgrounds.size() <= 300));
      allow delete: if isAdmin();

      match /elements/{elementId} {
        allow read: if liveGroupParticipant(roomId);
        allow create: if liveGroupParticipant(roomId) && whiteboardElementCreateValid(request.resource.data);
        allow update: if liveGroupParticipant(roomId) && whiteboardElementUpdateValid(resource.data, request.resource.data, isAdmin() || isTeacher());
        allow delete: if liveGroupParticipant(roomId) && resource.data.get('locked', false) != true && whiteboardMaterialStaffOnly(resource.data);
      }

      match /lessonPages/{pageId} {
        allow read: if liveGroupParticipant(roomId);
        allow create: if liveGroupParticipant(roomId)
          && validLessonPage(request.resource.data)
          && request.resource.data.status == 'active'
          && request.resource.data.isSnapshot == false;
        allow update: if liveGroupParticipant(roomId)
          && resource.data.isSnapshot == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'updatedAt', 'updatedByUid', 'updatedByName'])
          && validLessonPage(request.resource.data);
        allow delete: if liveGroupParticipant(roomId) && (isAdmin() || isTeacher());

        match /elements/{elementId} {
          allow read: if liveGroupParticipant(roomId);
          allow create: if liveGroupParticipant(roomId) && whiteboardElementCreateValid(request.resource.data);
          allow update: if liveGroupParticipant(roomId) && whiteboardElementUpdateValid(resource.data, request.resource.data, isAdmin() || isTeacher());
          allow delete: if liveGroupParticipant(roomId) && resource.data.get('locked', false) != true && whiteboardMaterialStaffOnly(resource.data);
        }
      }
    }

    match /liveLessonInvitations/{invitationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.teacherUid == uid())
        || (signedIn() && resource.data.studentUid == uid());
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly([
          'teacherUid',
          'teacherName',
          'studentId',
          'studentUid',
          'studentName',
          'title',
          'status',
          'roomKey',
          'createdAt',
          'createdAtIso',
          'expiresAt',
          'respondedAt',
          'cancelledAt',
          'closedAt'
        ])
        && request.resource.data.teacherUid == uid()
        && teacherCanInviteStudent(request.resource.data.studentId)
        && studentAccountOwns(
          request.resource.data.studentId,
          request.resource.data.studentUid
        )
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.teacherName.size() <= 160
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 160
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.status == 'pending'
        && (
          request.resource.data.roomKey == invitationId
          || liveGroupInvites(request.resource.data.roomKey, request.resource.data.studentUid)
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAtIso is string
        && request.resource.data.createdAtIso.size() <= 40
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(5, 'm')
        && request.resource.data.respondedAt == null
        && request.resource.data.cancelledAt == null
        && request.resource.data.closedAt == null;
      allow update: if request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.roomKey == resource.data.roomKey
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'respondedAt',
          'cancelledAt',
          'closedAt'
        ])
        && (
          (
            resource.data.status == 'pending'
            && (
              (
                signedIn()
                && resource.data.studentUid == uid()
                && request.time < resource.data.expiresAt
                && request.resource.data.status in ['accepted', 'declined']
                && request.resource.data.respondedAt == request.time
                && request.resource.data.cancelledAt == null
                && request.resource.data.closedAt == null
              )
              // a test student (testStudent on the card) cannot answer: the inviting teacher or an admin accepts for them
              || (
                (isAdmin() || (signedIn() && resource.data.teacherUid == uid()))
                && request.time < resource.data.expiresAt
                && exists(studentPath(resource.data.studentId))
                && studentDoc(resource.data.studentId).get('testStudent', false) == true
                && request.resource.data.status == 'accepted'
                && request.resource.data.respondedAt == request.time
                && request.resource.data.cancelledAt == null
                && request.resource.data.closedAt == null
              )
              || (
                (isAdmin() || (signedIn() && resource.data.teacherUid == uid()))
                && request.resource.data.status == 'cancelled'
                && request.resource.data.cancelledAt == request.time
                && request.resource.data.respondedAt == null
                && request.resource.data.closedAt == null
              )
            )
          )
          || (
            resource.data.status == 'accepted'
            && (isAdmin() || (signedIn() && resource.data.teacherUid == uid()))
            && request.resource.data.status == 'closed'
            && request.resource.data.respondedAt == resource.data.respondedAt
            && request.resource.data.cancelledAt == resource.data.cancelledAt
            && request.resource.data.closedAt == request.time
          )
        );
      allow delete: if isAdmin();

      match /signals/{signalId} {
        allow read: if canUseLiveLessonInvitation(invitationId);
        allow create: if canUseLiveLessonInvitation(invitationId)
          && request.resource.data.keys().hasOnly([
            'type',
            'sessionId',
            'senderUid',
            'senderRole',
            'payload',
            'createdAt',
            'createdAtIso'
          ])
          && request.resource.data.keys().hasAll([
            'type',
            'sessionId',
            'senderUid',
            'senderRole',
            'payload',
            'createdAt',
            'createdAtIso'
          ])
          && request.resource.data.type in ['offer', 'answer', 'candidate', 'hangup']
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() > 0
          && request.resource.data.sessionId.size() <= 120
          && request.resource.data.senderUid == uid()
          && request.resource.data.senderRole in ['teacher', 'student']
          && liveLessonSignalRoleMatches(invitationId, request.resource.data.senderRole)
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 64000
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdAtIso is string
          && request.resource.data.createdAtIso.size() <= 40;
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /presence/{presenceId} {
        allow read: if canUseLiveLessonInvitation(invitationId);
        allow create, update: if canUseLiveLessonInvitation(invitationId)
          && presenceId == uid()
          && request.resource.data.keys().hasOnly([
            'uid',
            'role',
            'displayName',
            'online',
            'lastSeen',
            'lastSeenIso'
          ])
          && request.resource.data.keys().hasAll([
            'uid',
            'role',
            'displayName',
            'online',
            'lastSeen',
            'lastSeenIso'
          ])
          && request.resource.data.uid == uid()
          && request.resource.data.role in ['teacher', 'student']
          && liveLessonSignalRoleMatches(invitationId, request.resource.data.role)
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 160
          && request.resource.data.online is bool
          && request.resource.data.lastSeen == request.time
          && request.resource.data.lastSeenIso is string
          && request.resource.data.lastSeenIso.size() <= 40
          && (
            !exists(/databases/$(database)/documents/liveLessonInvitations/$(invitationId)/presence/$(presenceId))
            || (
              request.resource.data.uid == resource.data.uid
              && request.resource.data.role == resource.data.role
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'displayName',
                'online',
                'lastSeen',
                'lastSeenIso'
              ])
            )
          );
        allow delete: if isAdmin();
      }

      // Administrator watching the lesson (Live Classroom „Vaata tundi”, owner 2026-10-14): the observer's own entry
      // (teacher and student see „Administraator vaatab tundi”) and the receive-only call signals between the
      // observer and each participant. The 1:1 call itself (signals) is unchanged.
      match /observers/{observerUid} {
        allow read: if isAdmin() || canReadLiveLessonRoom(invitationId);
        allow create, update: if isAdmin()
          && observerUid == uid()
          && get(liveLessonInvitationPath(invitationId)).data.status == 'accepted'
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'active', 'joinedAt', 'lastSeen', 'lastSeenIso'])
          && request.resource.data.keys().hasAll(['uid', 'displayName', 'active', 'lastSeen', 'lastSeenIso'])
          && request.resource.data.uid == uid()
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 160
          && request.resource.data.active is bool
          && request.resource.data.lastSeen == request.time
          && request.resource.data.lastSeenIso is string
          && request.resource.data.lastSeenIso.size() <= 40;
        allow delete: if isAdmin();
      }

      match /observerSignals/{signalId} {
        allow read: if signedIn()
          && resource.data.toUid == uid()
          && (isAdmin() || canUseLiveLessonInvitation(invitationId));
        allow create: if signedIn()
          && get(liveLessonInvitationPath(invitationId)).data.status == 'accepted'
          && request.resource.data.keys().hasOnly(['type', 'sessionId', 'observerUid', 'fromUid', 'toUid', 'payload', 'createdAt', 'createdAtIso'])
          && request.resource.data.keys().hasAll(['type', 'sessionId', 'observerUid', 'fromUid', 'toUid', 'payload', 'createdAt', 'createdAtIso'])
          && request.resource.data.type in ['offer', 'answer', 'candidate', 'hangup']
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() > 0
          && request.resource.data.sessionId.size() <= 120
          && request.resource.data.fromUid == uid()
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 64000
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdAtIso is string
          && request.resource.data.createdAtIso.size() <= 40
          && (
            (
              isAdmin()
              && request.resource.data.observerUid == uid()
              && request.resource.data.toUid in [
                get(liveLessonInvitationPath(invitationId)).data.teacherUid,
                get(liveLessonInvitationPath(invitationId)).data.studentUid
              ]
            )
            || (
              canUseLiveLessonInvitation(invitationId)
              && request.resource.data.toUid == request.resource.data.observerUid
              && exists(/databases/$(database)/documents/liveLessonInvitations/$(invitationId)/observers/$(request.resource.data.observerUid))
              && get(/databases/$(database)/documents/liveLessonInvitations/$(invitationId)/observers/$(request.resource.data.observerUid)).data.active == true
            )
          );
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /whiteboardElements/{elementId} {
        allow read: if canReadLiveLessonRoom(invitationId);
        allow create: if canUseLiveLessonInvitation(invitationId)
          && validLiveLessonWhiteboardStroke(request.resource.data);
        allow update: if false;
        allow delete: if canUseLiveLessonInvitation(invitationId)
          && (
            resource.data.updatedByUid == uid()
            || get(liveLessonInvitationPath(invitationId)).data.teacherUid == uid()
          );
      }
    }

    // guest links and grants are written only by the server (functions/live-guest.js); a guest reads its own grant
    match /liveGuestLinks/{tokenHash} {
      allow read, write: if false;
    }

    match /liveGuestGrants/{guestUid} {
      allow read: if signedIn() && guestUid == uid();
      allow write: if false;
    }

    match /liveClassrooms/{classroomId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.teacherUid == uid())
        || ownsStudent(resource.data.studentId);
      allow create: if isStaff()
        && request.resource.data.teacherUid == uid()
        && request.resource.data.studentId is string
        && request.resource.data.studentId != ''
        && exists(studentPath(request.resource.data.studentId))
        && request.resource.data.status == 'waiting'
        && request.resource.data.sceneVersion == 1
        && request.resource.data.accessVersion == 1
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.activeScene.type == 'welcome'
        && validLiveScene(request.resource.data.activeScene, 1)
        && validLiveScreenShare(request.resource.data.screenShare)
        && request.resource.data.screenShare.status == 'idle';
      allow update: if (
          isAdmin()
          || (
            isStaff()
            && resource.data.teacherUid == uid()
          )
        )
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.accessVersion == resource.data.accessVersion
        && request.resource.data.status in ['waiting', 'live', 'ended']
        && (resource.data.status != 'ended' || request.resource.data.status == 'ended')
        && (
          request.resource.data.status != 'ended'
          || (
            (
              (
                request.resource.data.summaryVersion == 1
                && validLiveLessonSummaryV1(request.resource.data.lessonSummary)
              )
              || (
                request.resource.data.summaryVersion == 2
                && validLiveLessonSummaryV2(request.resource.data.lessonSummary)
                && liveLessonProgressMatches(
                  classroomId,
                  resource.data.studentId,
                  request.resource.data.lessonSummary
                )
              )
            )
            && liveLessonHomeworkMatches(
              classroomId,
              resource.data.studentId,
              request.resource.data.lessonSummary
            )
          )
        )
        && (
          request.resource.data.status == 'ended'
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'lessonSummary',
            'summaryVersion'
          ])
        )
        && (
          resource.data.status != 'ended'
          || (
            request.resource.data.lessonSummary == resource.data.lessonSummary
            && request.resource.data.summaryVersion == resource.data.summaryVersion
          )
        )
        && request.resource.data.sceneVersion == resource.data.sceneVersion + 1
        && validLiveScene(
          request.resource.data.activeScene,
          request.resource.data.sceneVersion
        )
        && validLiveScreenShare(request.resource.data.screenShare)
        && (
          (
            request.resource.data.activeScene.type == 'screen'
            && request.resource.data.screenShare.status == 'active'
          )
          || (
            request.resource.data.activeScene.type != 'screen'
            && request.resource.data.screenShare.status == 'idle'
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeScene',
          'sceneVersion',
          'status',
          'startedAt',
          'endedAt',
          'lessonSummary',
          'summaryVersion',
          'screenShare',
          'updatedAt'
        ]);
      allow delete: if isAdmin();

      match /scenes/{sceneId} {
        allow read: if hostsLiveClassroom(classroomId) || ownsLiveClassroom(classroomId);
        allow create: if hostsLiveClassroom(classroomId)
          && request.resource.data.keys().hasOnly([
            'classroomId',
            'sceneVersion',
            'eventType',
            'scene',
            'studentId',
            'studentName',
            'teacherUid',
            'teacherName',
            'createdAt',
            'createdAtIso'
          ])
          && request.resource.data.keys().hasAll([
            'classroomId',
            'sceneVersion',
            'eventType',
            'scene',
            'studentId',
            'studentName',
            'teacherUid',
            'teacherName',
            'createdAt',
            'createdAtIso'
          ])
          && request.resource.data.classroomId == classroomId
          && request.resource.data.sceneVersion is int
          && request.resource.data.sceneVersion > 1
          && request.resource.data.sceneVersion
            == getAfter(liveClassroomPath(classroomId)).data.sceneVersion
          && request.resource.data.eventType in [
            'scene_published',
            'material_published',
            'screen_started',
            'screen_stopped',
            'lesson_ended'
          ]
          && validLiveScene(
            request.resource.data.scene,
            request.resource.data.sceneVersion
          )
          && request.resource.data.studentId
            == liveClassroomData(classroomId).studentId
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() <= 160
          && request.resource.data.teacherUid
            == liveClassroomData(classroomId).teacherUid
          && request.resource.data.teacherName is string
          && request.resource.data.teacherName.size() <= 160
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt <= request.time
          && request.resource.data.createdAt >= request.time - duration.value(5, 'm')
          && request.resource.data.createdAtIso is string
          && request.resource.data.createdAtIso.size() <= 40;
        allow update, delete: if false;
      }

      match /responses/{responseId} {
        allow read: if hostsLiveClassroom(classroomId) || ownsLiveClassroom(classroomId);
        allow create: if ownsLiveClassroom(classroomId)
          && liveClassroomData(classroomId).status != 'ended'
          && liveClassroomData(classroomId).activeScene.type in ['choice', 'short_answer']
          && request.resource.data.studentUid == uid()
          && request.resource.data.studentId == liveClassroomData(classroomId).studentId
          && request.resource.data.sceneVersion == liveClassroomData(classroomId).sceneVersion
          && request.resource.data.answer is string
          && request.resource.data.answer.size() > 0
          && request.resource.data.answer.size() <= 1600;
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /presence/{presenceId} {
        allow read: if hostsLiveClassroom(classroomId) || ownsLiveClassroom(classroomId);
        allow create, update: if signedIn()
          && presenceId == uid()
          && liveClassroomData(classroomId).status != 'ended'
          && request.resource.data.keys().hasOnly([
            'classroomId',
            'uid',
            'role',
            'displayName',
            'online',
            'lastSeen',
            'lastSeenIso'
          ])
          && request.resource.data.classroomId == classroomId
          && request.resource.data.uid == uid()
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 160
          && request.resource.data.online is bool
          && request.resource.data.lastSeen is timestamp
          && request.resource.data.lastSeen <= request.time
          && request.resource.data.lastSeen >= request.time - duration.value(2, 'm')
          && request.resource.data.lastSeenIso is string
          && request.resource.data.lastSeenIso.size() <= 40
          && (
            (
              hostsLiveClassroom(classroomId)
              && request.resource.data.role == 'teacher'
            )
            || (
              ownsLiveClassroom(classroomId)
              && request.resource.data.role == 'student'
            )
          )
          && (
            !exists(/databases/$(database)/documents/liveClassrooms/$(classroomId)/presence/$(presenceId))
            || (
              request.resource.data.classroomId == resource.data.classroomId
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.role == resource.data.role
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'displayName',
                'online',
                'lastSeen',
                'lastSeenIso'
              ])
            )
          );
        allow delete: if isAdmin();
      }

      match /signals/{signalId} {
        allow read: if hostsLiveClassroom(classroomId) || ownsLiveClassroom(classroomId);
        allow create: if signedIn()
          && liveClassroomData(classroomId).status == 'live'
          && liveClassroomData(classroomId).screenShare.status == 'active'
          && liveClassroomData(classroomId).screenShare.shareId != ''
          && request.resource.data.senderUid == uid()
          && request.resource.data.type in ['offer', 'answer', 'candidate']
          && request.resource.data.payload is string
          && request.resource.data.payload.size() > 0
          && request.resource.data.payload.size() <= 25000
          && request.resource.data.shareId == liveClassroomData(classroomId).screenShare.shareId
          && (
            (
              hostsLiveClassroom(classroomId)
              && request.resource.data.senderRole == 'teacher'
            )
            || (
              ownsLiveClassroom(classroomId)
              && request.resource.data.senderRole == 'student'
            )
          );
        allow update, delete: if false;
      }
    }

    match /meta/invoiceCounter {
      allow read, write: if isStaff();
    }

    // „Õppesuunad” (owner 2026-10-24: „самому ставить учебные направления”): the school's list of study directions,
    // kept by the administrator in Seaded; staff and finance read it to choose a subject. Never deleted, only archived.
    function studyDirectionValid(data) {
      return data.keys().hasOnly(['name', 'shortLabel', 'color', 'levels', 'aliases', 'status', 'order', 'createdAt',
          'updatedAt', 'updatedByUid', 'updatedByName'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.get('shortLabel', '') is string && data.get('shortLabel', '').size() <= 6
        && data.get('color', '') is string && (data.get('color', '') == '' || data.get('color', '').matches('^#[0-9a-fA-F]{6}$'))
        && data.get('levels', []) is list && data.get('levels', []).size() <= 30
        && data.get('aliases', []) is list && data.get('aliases', []).size() <= 20
        && data.status in ['active', 'archived']
        && data.get('order', 0) is int && data.get('order', 0) >= 0 && data.get('order', 0) <= 999
        && data.updatedByUid == uid();
    }
    // „Planeerija” (owner 2026-10-25): one record per „Kinnita ajakava” — which weekly lessons it created for which
    // students (the schedule e-mail reads it on the server). The administrator creates it once, with fixed keys;
    // nobody changes or deletes it from the app (the server updates its status with the admin SDK).
    // „Ärinäitajad”: the school's monthly fixed costs and the owner's own lessons (admin only)
    match /businessSettings/{settingId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && settingId == 'current'
        && request.resource.data.keys().hasOnly(['fixedCosts', 'ownerTeacher', 'ownerRateCents', 'updatedAt', 'updatedByUid'])
        && request.resource.data.fixedCosts is list
        && request.resource.data.fixedCosts.size() <= 20
        && request.resource.data.ownerTeacher is string
        && request.resource.data.ownerTeacher.size() <= 80
        && request.resource.data.ownerRateCents is int
        && request.resource.data.ownerRateCents >= 0
        && request.resource.data.ownerRateCents <= 100000
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedByUid == uid();
      allow delete: if false;
    }
    // „Kampaaniad” (owner 2026-10-27): offers, ad campaigns and events prepared by the administrator; archived, never deleted
    function campaignValid(data) {
      return data.keys().hasOnly(['title', 'kind', 'status', 'startDate', 'endDate', 'audience', 'offer', 'goal', 'targetSignups', 'signups',
          'budgetCents', 'spentCents', 'groupId', 'channels', 'posts', 'checklist', 'notes', 'createdAt', 'createdByUid', 'createdByName', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.kind in ['offer', 'ad', 'event']
        && data.status in ['idea', 'preparing', 'ready', 'live', 'done', 'archived']
        && data.startDate is string && data.startDate.size() <= 10
        && data.endDate is string && data.endDate.size() <= 10
        && data.audience is string && data.audience.size() <= 300
        && data.offer is string && data.offer.size() <= 1000
        && data.goal is string && data.goal.size() <= 300
        && data.notes is string && data.notes.size() <= 3000
        && data.targetSignups is int && data.targetSignups >= 0
        && data.signups is int && data.signups >= 0
        && data.budgetCents is int && data.budgetCents >= 0
        && data.spentCents is int && data.spentCents >= 0
        && data.groupId is string && data.groupId.size() <= 128
        && data.channels is list && data.channels.size() <= 6
        && data.posts is list && data.posts.size() <= 30
        && data.checklist is list && data.checklist.size() <= 40
        && data.createdAt is string && data.createdByUid is string && data.createdByName is string && data.updatedAt is string;
    }
    match /campaigns/{campaignId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && campaignValid(request.resource.data) && request.resource.data.createdByUid == uid();
      allow update: if isAdmin() && campaignValid(request.resource.data)
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /plannerBatches/{batchId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['createdAt', 'createdBy', 'lessonIds', 'studentIds', 'status'])
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdAt == request.time
        && request.resource.data.lessonIds is list
        && request.resource.data.lessonIds.size() > 0
        && request.resource.data.lessonIds.size() <= 500
        && request.resource.data.studentIds is list
        && request.resource.data.studentIds.size() <= 500
        && request.resource.data.status == 'confirmed';
      allow update, delete: if false;
    }

    match /studyDirections/{directionId} {
      allow read: if isStaff() || isFinance();
      allow create, update: if isAdmin() && studyDirectionValid(request.resource.data);
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read, write: if isStaff();
    }

    match /tasks/{taskId} {
      allow read, write: if isStaff();
    }

    match /reconciliation/{docId} {
      allow read, write: if isAdmin();
    }

    // Payroll evidence is created and changed only by trusted Cloud Functions.
    // Staff can see their own sessions; owners can review every session.
    match /workSessions/{sessionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.staffUid == uid());
      allow create, update, delete: if false;
    }

    match /workTimeAudit/{entryId} {
      allow read: if isAdmin() || (signedIn() && resource.data.staffUid == uid());
      allow create, update, delete: if false;
    }

    // Concurrency guard for one open shift per staff member.
    match /workSessionOpen/{staffUid} {
      allow read, write: if false;
    }

    // Active program time is measured by a trusted heartbeat endpoint. The
    // browser never submits a duration and cannot edit payroll evidence.
    match /staffProgramDays/{dayId} {
      allow read: if isAdmin() || (signedIn() && resource.data.staffUid == uid());
      allow create, update, delete: if false;
    }

    // Internal cross-tab pointer used to prevent duplicate time when several
    // KeeleSepp windows are open at once.
    match /staffProgramPresence/{staffUid} {
      allow read, write: if false;
    }

    // The scheduled rule-based monitor writes these alerts. Only an
    // administrator can see operational and financial attention items.
    match /assistantAlerts/{alertId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /activityLog/{entryId} {
      allow read: if isStaff();
      allow create: if signedIn()
        && request.resource.data.byUid == uid()
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 120
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 300
        && request.resource.data.createdAt is string
        && request.resource.data.date is string
        && (
          isStaff()
          || !request.resource.data.type.matches('^(lesson|invoice|finance|payment|schedule|group|parent|students?|task|curriculum|live_lesson|account|learning_material|learning_exercise|worksheet_doc|expense|accounting|homework)[.].*')
        );
      allow update, delete: if isAdmin();
    }

    match /curriculumProgressEvents/{eventId} {
      allow read: if isStaff() || ownsStudent(resource.data.studentId);
      allow create: if isStaff()
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.actorUid == uid()
        && request.resource.data.action in ['credit_awarded', 'credit_revoked']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 500;
      allow update, delete: if false;
    }

    // The course is the school's own material (owner 2026-10-12: protect it from being spread): only staff and approved
    // students linked to a student card read it. „signedIn()” alone let any self-made account without a profile
    // download every lesson.
    function courseReader() {
      return isStaff()
        || (signedIn() && hasUserDoc(uid())
          && get(userPath(uid())).data.get('role', '') == 'student'
          && get(userPath(uid())).data.get('linkedStudentIds', []).size() > 0);
    }

    match /curriculumLessons/{lessonId} {
      allow read: if courseReader();
      allow write: if isStaff();

      // A lesson may own several independent Worksheet Studio documents.
      // The legacy worksheetDoc fields on the lesson stay a separate contract.
      match /worksheets/{worksheetId} {
        allow read: if courseReader();
        allow create, update, delete: if isStaff();
      }
    }

    // Shared staff didactics library. Books and methodical resources are
    // separate from curriculum lessons so they do not distort course counts.
    match /didacticLibrary/{materialId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 240
        && request.resource.data.uploaderUid == uid();
      allow update, delete: if isStaff();
    }

    // Immutable worksheet snapshots keep published assignments stable while
    // teachers continue editing newer drafts in curriculumLessons.
    match /worksheetVersions/{versionId} {
      allow read, create: if isStaff();
      allow update, delete: if false;
    }

    // Calendar: a teacher's green (free) and red (busy) windows. Staff read them (the admin plans lessons by them);
    // the teacher edits their own, the admin anyone's.
    // „Ei saa tulla?” (owner 2026-10-12): a student or parent asks to move one lesson of their own card; the lesson's
    // teacher (or an admin) confirms one time or declines; the asker may withdraw while pending. The calendar change
    // itself is the teacher's normal schedule write.
    match /lessonChangeRequests/{requestId} {
      allow read: if isAdmin()
        || (isStaff() && resource.data.teacherUid == uid())
        || ownsStudent(resource.data.studentId);
      allow create: if signedIn()
        && ownsStudent(request.resource.data.studentId)
        && request.resource.data.keys().hasOnly(['scheduleId', 'occurrenceDate', 'occurrenceTime', 'duration', 'studentId',
          'studentName', 'teacherUid', 'teacherName', 'requestedByUid', 'requestedByName', 'requestedByRole', 'proposals',
          'other', 'reason', 'late', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedByUid == uid()
        && request.resource.data.scheduleId is string
        && exists(/databases/$(database)/documents/schedule/$(request.resource.data.scheduleId))
        && get(/databases/$(database)/documents/schedule/$(request.resource.data.scheduleId)).data.get('studentId', '') == request.resource.data.studentId
        && get(/databases/$(database)/documents/schedule/$(request.resource.data.scheduleId)).data.get('teacherUid', '') == request.resource.data.teacherUid
        && request.resource.data.proposals is list && request.resource.data.proposals.size() <= 3
        && request.resource.data.other is string && request.resource.data.other.size() <= 300
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300;
      allow update: if resource.data.status == 'pending'
        && (
          (
            (isAdmin() || (isStaff() && resource.data.teacherUid == uid()))
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'chosen', 'teacherNote', 'decidedAt', 'decidedByUid'])
          )
          || (
            ownsStudent(resource.data.studentId)
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          )
        );
      allow delete: if false;
    }

    match /teacherAvailability/{teacherUid} {
      // students and parents read the windows to ask for a new lesson time („Ei saa tulla?”, owner 2026-10-12): only
      // free/busy windows, never other students' lessons
      allow read: if isStaff()
        || (signedIn() && hasUserDoc(uid()) && get(userPath(uid())).data.get('role', '') in ['student', 'parent']);
      allow write: if (isAdmin() || (isStaff() && teacherUid == uid()))
        && request.resource.data.keys().hasOnly(['teacherUid', 'teacherName', 'slots', 'updatedAt', 'updatedBy'])
        && request.resource.data.teacherUid == teacherUid
        && request.resource.data.updatedBy == uid()
        && request.resource.data.slots is list
        && request.resource.data.slots.size() <= 200;
    }

    // Worksheet constructor: blocks a teacher saved as a template, shared with all staff; only the author or an admin
    // removes one, nobody edits it in place.
    match /worksheetBlockTemplates/{templateId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['title', 'block', 'ownerUid', 'ownerName', 'createdAt'])
        && request.resource.data.ownerUid == uid()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.block is map
        && request.resource.data.ownerName is string
        && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if isAdmin() || (isStaff() && resource.data.ownerUid == uid());
    }

    match /exercises/{exerciseId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // One persistent canvas per student. Admin always has access. A teacher
    // may open a board only for a student they own (same teacherUid scoping
    // rule used everywhere else once the migration flag is enforced, with
    // the same permissive name-matching fallback during migration). The
    // linked student/parent can always reach their own board.
    //
    // Each drawn object is its OWN document in the elements subcollection —
    // whiteboards/{studentId}/elements/{elementId} — so two people editing
    // different objects at once can never overwrite each other; only two
    // simultaneous edits to the SAME object fall back to Firestore's normal
    // last-write-wins, which is the deliberately simple model here (no CRDT).
    function whiteboardAccessAllowed(studentId) {
      return isAdmin()
        || (isTeacher() && exists(studentPath(studentId)) && teacherCanRead(studentDoc(studentId)))
        || ownsStudent(studentId)
        || liveGuestFor(studentId);
    }

    // Firestore rules cannot cheaply validate every point in a stroke's
    // point list, so this caps the point count and overall shape of each
    // element type; per-point numeric shape is left to the client plus
    // Firestore's own per-document size ceiling.
    function validWhiteboardElement(data) {
      return data is map
        && data.keys().hasAll(['type', 'updatedByUid'])
        && data.updatedByUid == uid()
        && data.type in ['stroke', 'shape', 'text', 'note', 'image', 'pdf']
        && (!('byStaff' in data) || data.byStaff == true)
        && (
          data.type != 'stroke'
          || (
            data.keys().hasOnly(['type', 'points', 'color', 'strokeWidth', 'updatedAt', 'updatedByUid', 'updatedByName', 'lastClientId', 'revision', 'byStaff'])
            && data.points is list
            && data.points.size() > 0
            && data.points.size() <= 800
            && data.color is string
            && data.strokeWidth is number
            && data.strokeWidth > 0
            && data.strokeWidth <= 40
          )
        )
        && (
          data.type != 'shape'
          || (
            data.keys().hasOnly(['type', 'shape', 'x', 'y', 'w', 'h', 'color', 'strokeWidth', 'updatedAt', 'updatedByUid', 'updatedByName', 'lastClientId', 'revision', 'byStaff'])
            && data.shape in ['rect', 'ellipse', 'line', 'arrow']
            && data.x is number && data.y is number
            && data.w is number && data.h is number
            && data.color is string
            && data.strokeWidth is number
            && data.strokeWidth > 0
            && data.strokeWidth <= 40
          )
        )
        && (
          data.type != 'text'
          || (
            data.keys().hasOnly(['type', 'x', 'y', 'w', 'h', 'text', 'color', 'fontSize', 'fontFamily', 'updatedAt', 'updatedByUid', 'updatedByName', 'lastClientId', 'revision', 'byStaff'])
            && data.x is number && data.y is number
            && data.w is number && data.h is number
            && data.text is string
            && data.text.size() <= 4000
            && data.color is string
            && data.fontSize is number
            && data.fontSize > 0
            && data.fontSize <= 96
            && (!('fontFamily' in data) || data.fontFamily in ['sans', 'serif', 'hand', 'mono'])
          )
        )
        && (
          data.type != 'note'
          || (
            data.keys().hasOnly(['type', 'x', 'y', 'w', 'h', 'text', 'color', 'updatedAt', 'updatedByUid', 'updatedByName', 'lastClientId', 'revision', 'byStaff'])
            && data.x is number && data.y is number
            && data.w is number && data.h is number
            && data.text is string
            && data.text.size() <= 2000
            && data.color is string
          )
        )
        && (
          data.type != 'image'
          || (
            data.keys().hasOnly(['type', 'x', 'y', 'w', 'h', 'url', 'storagePath', 'rotation', 'locked', 'updatedAt', 'updatedByUid', 'updatedByName', 'lastClientId', 'revision', 'byStaff', 'byStudent'])
            && (!('byStudent' in data) || data.byStudent == true)
            && data.x is number && data.y is number
            && data.w is number && data.h is number
            && data.w > 0 && data.h > 0 && data.w <= 100000 && data.h <= 100000
            && data.url is string && data.url.size() > 0 && data.url.size() <= 2000
            && data.url.matches('^https://.*')
            && (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 1000))
            && (!('rotation' in data) || (data.rotation is number && data.rotation >= -360000 && data.rotation <= 360000))
            && (!('locked' in data) || data.locked is bool)
          )
        )
        && (
          data.type != 'pdf'
          || (
            data.keys().hasOnly(['type', 'x', 'y', 'w', 'h', 'url', 'storagePath', 'name', 'rotation', 'locked', 'updatedAt', 'updatedByUid', 'updatedByName', 'lastClientId', 'revision', 'byStaff'])
            && data.x is number && data.y is number
            && data.w is number && data.h is number
            && data.w > 0 && data.h > 0 && data.w <= 100000 && data.h <= 100000
            && data.url is string && data.url.size() > 0 && data.url.size() <= 2000
            && data.url.matches('^https://.*')
            && (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 1000))
            && (!('name' in data) || (data.name is string && data.name.size() <= 300))
            && (!('rotation' in data) || (data.rotation is number && data.rotation >= -360000 && data.rotation <= 360000))
            && (!('locked' in data) || data.locked is bool)
          )
        );
    }

    // Lesson-scoped board pages live alongside the one persistent board
    // above: same student, same access rule, but their own subcollection so
    // the always-on canvas is never touched by lesson-page reads/writes.
    // Creating/completing pages is a teaching action (staff only); anyone
    // with board access can still read them and draw on their elements,
    // same as the persistent board.
    function whiteboardStaffAction(studentId) {
      return isAdmin() || (isTeacher() && whiteboardAccessAllowed(studentId));
    }

    // Access is checked once: whiteboardStaffAction() would evaluate whiteboardAccessAllowed() a second time and a
    // teacher's image/PDF create then hit Firestore's 1000-expression limit (permission-denied). With access already
    // granted, "staff action" is exactly admin or teacher.
    function whiteboardElementCreateAllowed(studentId, data) {
      let admin = isAdmin();
      let teacher = isTeacher();
      return whiteboardAccessAs(studentId, admin, teacher)
        && whiteboardElementCreateValidAs(data, admin || teacher);
    }

    // Board access with the caller's roles already known: every isAdmin()/isTeacher() costs many expressions, and
    // board writes sit close to Firestore's 1000-expression limit (a teacher's image on a lesson page).
    function whiteboardAccessAs(studentId, admin, teacher) {
      return admin
        || (
          teacher
          && exists(studentPath(studentId))
          && (
            !teacherScopeReadEnforced()
            || studentDoc(studentId).get('teacherUid', '') == uid()
            || studentDoc(studentId).get('teacherUids', []).hasAny([uid()])
          )
        )
        || ownsStudent(studentId)
        || liveGuestFor(studentId);
    }

    function whiteboardPageElementCreateAllowed(studentId, pageId, data) {
      let admin = isAdmin();
      let teacher = isTeacher();
      return whiteboardAccessAs(studentId, admin, teacher)
        && (
          (lessonPageLive(studentId, pageId) && whiteboardElementCreateValidAs(data, admin || teacher))
          || ((admin || teacher) && snapshotPageActive(studentId, pageId) && validWhiteboardElement(data))
        );
    }

    function whiteboardPageElementUpdateAllowed(studentId, pageId, before, after) {
      let admin = isAdmin();
      let teacher = isTeacher();
      return whiteboardAccessAs(studentId, admin, teacher)
        && lessonPageLive(studentId, pageId)
        && whiteboardElementUpdateValid(before, after, admin || teacher);
    }

    function whiteboardMaterialSourceUnchanged(before, after) {
      return after.type == before.type
        && after.get('url', '') == before.get('url', '')
        && after.get('storagePath', '') == before.get('storagePath', '')
        && after.get('name', '') == before.get('name', '');
    }

    function whiteboardMaterialLockTransitionAllowed(before, after) {
      return before.get('locked', false) != true
        || (
          after.get('locked', false) == false
          && after.x == before.x
          && after.y == before.y
          && after.w == before.w
          && after.h == before.h
          && after.get('rotation', 0) == before.get('rotation', 0)
        );
    }

    // Teacher materials (images, PDFs) can only be added by staff, so only staff may move, resize or delete them:
    // a student's eraser or drag must never remove what the teacher put on the board.
    // Teacher content (images/PDFs, and since 2026-10-04 everything a teacher draws or writes: byStaff) is moved,
    // changed and erased only by staff; a student's eraser never removes it.
    // A student's own photo (byStudent, an image only) is the student's: they may move, resize and erase it.
    function whiteboardMaterialStaffOnly(data) {
      return ((!(data.type in ['image', 'pdf']) || data.get('byStudent', false) == true) && data.get('byStaff', false) != true) || isAdmin() || isTeacher();
    }

    // `staff` (admin or teacher) is computed once by the caller: re-checking roles here pushed teacher writes over
    // Firestore's 1000-expression limit
    function whiteboardElementUpdateValid(before, after, staff) {
      return validWhiteboardElement(after)
        && after.type == before.type
        && after.get('byStaff', false) == before.get('byStaff', false)
        && after.get('byStudent', false) == before.get('byStudent', false)
        && (staff || ((!(before.type in ['image', 'pdf']) || before.get('byStudent', false) == true) && before.get('byStaff', false) != true))
        && (
          !(after.type in ['image', 'pdf'])
          || (
            whiteboardMaterialSourceUnchanged(before, after)
            && whiteboardMaterialLockTransitionAllowed(before, after)
          )
        );
    }

    function whiteboardElementUpdateAllowed(studentId, before, after) {
      let admin = isAdmin();
      let teacher = isTeacher();
      return whiteboardAccessAs(studentId, admin, teacher)
        && whiteboardElementUpdateValid(before, after, admin || teacher);
    }

    function whiteboardElementDeleteAllowed(studentId, data) {
      return whiteboardAccessAllowed(studentId)
        && data.get('locked', false) != true
        && whiteboardMaterialStaffOnly(data);
    }

    // Element shape plus "only staff add images/PDFs", for rules that have already checked board access once.
    // Students add their own photos too (owner, 2026-10-09): an image marked byStudent, uploaded to the board's
    // student folder in Storage.
    function whiteboardElementCreateValid(data) {
      return whiteboardElementCreateValidAs(data, isAdmin() || isTeacher());
    }

    function whiteboardElementCreateValidAs(data, staff) {
      return validWhiteboardElement(data)
        && (
          (!(data.type in ['image', 'pdf']) && !('byStaff' in data) && !('byStudent' in data))
          || (
            data.type == 'image' && data.get('byStudent', false) == true && !('byStaff' in data)
            && data.url.matches('^https://firebasestorage[.]googleapis[.]com/.*')
            && data.get('storagePath', '').matches('^whiteboards/[^/]+/student/[^/]+$')
          )
          || staff
        );
    }

    function lessonPagePath(studentId, pageId) {
      return /databases/$(database)/documents/whiteboards/$(studentId)/lessonPages/$(pageId);
    }

    // Lesson page state only; board access is checked once by the caller (checking it again for every helper made
    // teacher writes on lesson pages exceed Firestore's 1000-expression limit).
    function lessonPageLive(studentId, pageId) {
      return exists(lessonPagePath(studentId, pageId))
        && get(lessonPagePath(studentId, pageId)).data.isSnapshot != true;
    }

    function snapshotPageActive(studentId, pageId) {
      return exists(lessonPagePath(studentId, pageId))
        && get(lessonPagePath(studentId, pageId)).data.isSnapshot == true
        && get(lessonPagePath(studentId, pageId)).data.status == 'active';
    }

    function validLessonPage(data) {
      return data is map
        && data.keys().hasOnly([
          'title', 'order', 'status', 'isSnapshot', 'snapshotOf',
          'createdAt', 'updatedAt', 'updatedByUid', 'updatedByName'
        ])
        && data.keys().hasAll([
          'title', 'order', 'status', 'isSnapshot', 'snapshotOf',
          'createdAt', 'updatedAt', 'updatedByUid', 'updatedByName'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.order is int && data.order > 0 && data.order <= 1000000
        && data.status in ['active', 'completed']
        && data.isSnapshot is bool
        && (
          (data.isSnapshot == true
            && data.snapshotOf is string
            && data.snapshotOf.size() > 0
            && data.snapshotOf.size() <= 200)
          || (data.isSnapshot == false && data.snapshotOf == null)
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedByUid == uid()
        && data.updatedByName is string
        && data.updatedByName.size() <= 160;
    }

    match /whiteboards/{studentId} {
      // The parent document holds board metadata (schemaVersion, updatedAt)
      // and, only for boards created before the element-subcollection
      // migration, a legacy `elements` array kept around for one-time,
      // idempotent migration on first open — not deleted automatically.
      allow read: if whiteboardAccessAllowed(studentId);
      allow create, update: if whiteboardAccessAllowed(studentId)
        && request.resource.data.updatedByUid == uid()
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'updatedAt', 'updatedByUid', 'updatedByName', 'lastClientId', 'elements', 'backgrounds'
        ])
        // the paper of each page (dots, grid, lines, plain), keyed by page ('board' or a lesson page id)
        && (!('backgrounds' in request.resource.data) || (request.resource.data.backgrounds is map && request.resource.data.backgrounds.size() <= 300))
        && (
          !('elements' in request.resource.data)
          || (request.resource.data.elements is list && request.resource.data.elements.size() <= 800)
        );
      allow delete: if isAdmin();

      match /elements/{elementId} {
        allow read: if whiteboardAccessAllowed(studentId);
        allow create: if whiteboardElementCreateAllowed(studentId, request.resource.data);
        allow update: if whiteboardElementUpdateAllowed(studentId, resource.data, request.resource.data);
        allow delete: if whiteboardElementDeleteAllowed(studentId, resource.data);
      }

      match /lessonPages/{pageId} {
        allow read: if whiteboardAccessAllowed(studentId);
        // Staff create any page; the board's own student/parent may add an ordinary sheet (not a snapshot), e.g. a
        // separate page for an explanation or homework (owner, 2026-10-04).
        allow create: if whiteboardAccessAllowed(studentId)
          && validLessonPage(request.resource.data)
          && request.resource.data.status == 'active'
          && (isAdmin() || isTeacher() || request.resource.data.isSnapshot == false);
        allow update: if (
            whiteboardStaffAction(studentId)
            && validLessonPage(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.isSnapshot == resource.data.isSnapshot
            && request.resource.data.snapshotOf == resource.data.snapshotOf
            && (resource.data.status != 'completed' || request.resource.data.status == 'completed')
          )
          // everyone with the board renames an ordinary, active sheet (title only, signed)
          || (
            whiteboardAccessAllowed(studentId)
            && resource.data.isSnapshot == false
            && resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'updatedAt', 'updatedByUid', 'updatedByName'])
            && validLessonPage(request.resource.data)
          );
        // Completed lesson records and snapshots are historical evidence.
        allow delete: if whiteboardStaffAction(studentId) && resource.data.status != 'completed';

        match /elements/{elementId} {
          allow read: if whiteboardAccessAllowed(studentId);
          // A snapshot accepts one staff-authored initial copy while its
          // parent page is active. Once the parent becomes completed, the
          // element set is immutable, even through a direct page URL.
          allow create: if whiteboardPageElementCreateAllowed(studentId, pageId, request.resource.data);
          allow update: if whiteboardPageElementUpdateAllowed(studentId, pageId, resource.data, request.resource.data);
          allow delete: if whiteboardAccessAllowed(studentId)
            && (
              (lessonPageLive(studentId, pageId) && resource.data.get('locked', false) != true && whiteboardMaterialStaffOnly(resource.data))
              || ((isAdmin() || isTeacher()) && snapshotPageActive(studentId, pageId))
            );
        }
      }
    }

    match /oauthStates/{stateId} {
      allow read, write: if false;
    }

    // OAuth credentials are server-only. The client sees only sanitized status
    // metadata in users/{uid}.gcal.
    match /calendarConnections/{userId} {
      allow read, write: if false;
    }

    // Deferred Google Calendar deletions are created and retried only by
    // trusted Cloud Functions.
    match /calendarSyncOutbox/{entryId} {
      allow read, write: if false;
    }

    // Group lesson → Google event links are written only by the calendar
    // sync functions.
    match /calendarGroupEventLinks/{linkId} {
      allow read, write: if false;
    }

    // E-mails to students and parents (docs/EMAIL_NOTIFICATIONS.md): Seaded → E-kirjad. Only the administrator reads
    // and writes the settings (every type off until switched on); the log (no addresses) is read by the administrator
    // and written only by the server. Jobs, preferences and the link key (learnerEmailJobs, learnerEmailRuns,
    // emailPreferences, serverConfig) stay server-only (the closing match below).
    function learnerEmailTypeOk(entry) {
      return entry is map
        && entry.keys().hasOnly(['enabled', 'enabledAt', 'subjectEt', 'subjectRu', 'introEt', 'introRu'])
        && entry.keys().hasAll(['enabled', 'enabledAt', 'subjectEt', 'subjectRu', 'introEt', 'introRu'])
        && entry.enabled is bool
        && entry.enabledAt is string && entry.enabledAt.size() <= 40
        && entry.subjectEt is string && entry.subjectEt.size() <= 200
        && entry.subjectRu is string && entry.subjectRu.size() <= 200
        && entry.introEt is string && entry.introEt.size() <= 1000
        && entry.introRu is string && entry.introRu.size() <= 1000;
    }
    function learnerEmailSettingsOk(d) {
      return d.keys().hasOnly(['dailyHour', 'siteAddress', 'types', 'updatedAt', 'updatedBy', 'updatedByName'])
        && d.dailyHour is int && d.dailyHour >= 6 && d.dailyHour <= 21
        && d.get('siteAddress', '') is string && d.get('siteAddress', '').size() <= 200
        && d.types is map
        && d.types.keys().hasOnly(['lessonReminder', 'lessonMoved', 'lessonCancelled', 'newSchedule', 'homeworkDue', 'homeworkChecked', 'announcement'])
        && d.types.keys().hasAll(['lessonReminder', 'lessonMoved', 'lessonCancelled', 'newSchedule', 'homeworkDue', 'homeworkChecked', 'announcement'])
        && learnerEmailTypeOk(d.types.lessonReminder)
        && learnerEmailTypeOk(d.types.lessonMoved)
        && learnerEmailTypeOk(d.types.lessonCancelled)
        && learnerEmailTypeOk(d.types.newSchedule)
        && learnerEmailTypeOk(d.types.homeworkDue)
        && learnerEmailTypeOk(d.types.homeworkChecked)
        && learnerEmailTypeOk(d.types.announcement)
        && d.get('updatedBy', '') == uid();
    }
    match /emailSettings/{settingsId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && settingsId == 'learner' && learnerEmailSettingsOk(request.resource.data);
      allow delete: if false;
    }
    match /emailLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /emailQueue/{entryId} {
      // invoice and reminder e-mails (amounts, payers): administrator and bookkeeper only
      allow read: if isAdmin() || isFinance();
      allow write: if false;
    }

    // The browser may observe rollout state and the canonical name directory,
    // but only trusted migration functions may change either document.
    match /securityMigrations/{migrationId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /securityConfig/{configId} {
      allow read: if signedIn() && configId == 'teacherDirectoryV1';
      allow write: if false;
    }

    // Cloud lesson content is accessed only through the authenticated trusted API.
    match /interactiveAssignments/{assignmentId} { allow read, write: if false; }
    match /lessonDrafts/{id} { allow read, write: if false; }
    match /lessonVersions/{id} { allow read, write: if false; }
    match /publishedLessons/{id} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
